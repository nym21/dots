<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<!--
			The Siri and Apple Intelligence restrictions below are deprecated on
			macOS 26.4+ in favor of declarative management. They remain the
			documented manually installable compatibility path for this profile.
		-->
		<dict>
			<key>PayloadDescription</key>
			<string>Disable continuity, nearby sharing, diagnostics, Siri, and Apple Intelligence features.</string>
			<key>PayloadDisplayName</key>
			<string>Headless server restrictions</string>
			<key>PayloadIdentifier</key>
			<string>com.k.dots.server.restrictions</string>
			<key>PayloadType</key>
			<string>com.apple.applicationaccess</string>
			<key>PayloadUUID</key>
			<string>E3B11C27-8F94-4B44-9233-0C89032D41E0</string>
			<key>PayloadVersion</key>
			<integer>1</integer>

			<key>allowActivityContinuation</key>
			<false/>
			<key>allowAirDrop</key>
			<false/>
			<key>allowAirPlayIncomingRequests</key>
			<false/>
			<key>allowDiagnosticSubmission</key>
			<false/>

			<key>allowAssistant</key>
			<false/>
			<key>allowExternalIntelligenceIntegrations</key>
			<false/>
			<key>allowExternalIntelligenceIntegrationsSignIn</key>
			<false/>
			<key>allowAppleIntelligenceReport</key>
			<false/>
			<key>allowGenmoji</key>
			<false/>
			<key>allowImagePlayground</key>
			<false/>
			<key>allowWritingTools</key>
			<false/>
			<key>allowMailSmartReplies</key>
			<false/>
			<key>allowMailSummary</key>
			<false/>
			<key>allowNotesTranscription</key>
			<false/>
			<key>allowNotesTranscriptionSummary</key>
			<false/>
			<key>allowSafariSummary</key>
			<false/>
		</dict>
		<!--
			Undocumented preference keys for settings without a restriction, and
			download overrides that point each Apple Intelligence model set at a
			closed local port so macOS does not download it again. Mapped by
			RemoveMacAI (github.com/omlahore/RemoveMacAI) and pared
			(github.com/4evy/pared), both MIT. A macOS update can stop honoring them.
		-->
		<dict>
			<key>PayloadDescription</key>
			<string>Force Apple Intelligence settings that have no restriction off and block its model downloads.</string>
			<key>PayloadDisplayName</key>
			<string>Apple Intelligence settings and model downloads</string>
			<key>PayloadIdentifier</key>
			<string>com.k.dots.server.preferences</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>C3E3876A-7AFB-4EAD-AAA2-180E5FD9ECD0</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadContent</key>
			<dict>
				<!-- Siri, "Hey Siri", and the menu bar icon -->
				<key>com.apple.assistant.support</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>Assistant Enabled</key>
								<false/>
							</dict>
						</dict>
					</array>
				</dict>
				<key>com.apple.Siri</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>StatusMenuVisible</key>
								<false/>
								<key>VoiceTriggerUserEnabled</key>
								<false/>
							</dict>
						</dict>
					</array>
				</dict>

				<!-- Automatic summaries in Mail, Messages, and notifications -->
				<key>group.com.apple.mail</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>DisableAutomaticMessageSummarization</key>
								<true/>
								<key>PersonalizedSmartReplies</key>
								<false/>
							</dict>
						</dict>
					</array>
				</dict>
				<key>com.apple.MobileSMS</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>messageSummarizationEnabled</key>
								<false/>
							</dict>
						</dict>
					</array>
				</dict>
				<key>group.com.apple.usernoted</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>summarize_previews</key>
								<false/>
							</dict>
						</dict>
					</array>
				</dict>

				<!-- Inline text predictions and Spatial Photos -->
				<key>.GlobalPreferences</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>NSAutomaticInlinePredictionEnabled</key>
								<false/>
							</dict>
						</dict>
					</array>
				</dict>
				<key>com.apple.spatialphotosrelive</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>LocallyDisabled</key>
								<true/>
							</dict>
						</dict>
					</array>
				</dict>

				<!-- Model downloads -->
				<key>com.apple.MobileAsset</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>DownloadServerBaseURLOverride-com.apple.MobileAsset.UAF.FM.GenerativeModels</key>
								<string>https://127.0.0.1:9/blocked/</string>
								<key>DownloadServerBaseURLOverride-com.apple.MobileAsset.UAF.FM.Visual</key>
								<string>https://127.0.0.1:9/blocked/</string>
								<key>DownloadServerBaseURLOverride-com.apple.MobileAsset.UAF.FM.CodeLM</key>
								<string>https://127.0.0.1:9/blocked/</string>
								<key>DownloadServerBaseURLOverride-com.apple.MobileAsset.UAF.Photos.MagicCleanup</key>
								<string>https://127.0.0.1:9/blocked/</string>
								<key>DownloadServerBaseURLOverride-com.apple.MobileAsset.UAF.Photos.SpatialPhotosRelive</key>
								<string>https://127.0.0.1:9/blocked/</string>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Restrictions for a headless macOS server.</string>
	<key>PayloadDisplayName</key>
	<string>Headless Mac mini server</string>
	<key>PayloadIdentifier</key>
	<string>com.k.dots.server</string>
	<key>PayloadOrganization</key>
	<string>dots</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<!-- Replace with a new uuidgen value whenever this file changes. -->
	<key>PayloadUUID</key>
	<string>74773529-E5B8-448E-95FE-7969FC57558C</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
