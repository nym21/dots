#!/usr/bin/env bash
set -euo pipefail

# ship: this Mac's command, linked into ~/.local/bin by setup and kept there by
# ship update. It runs the scripts in this repository, so pulling it updates
# the command too. fleet, on the workstation, runs it across the servers.

DOTS_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
ROLE="$(cat "$HOME/.config/dots/role" 2>/dev/null || true)"

usage() {
    echo "Usage: ship COMMAND" >&2
    echo >&2
    echo "  update                      update everything, restart what changed, then macOS" >&2
    echo "  clean                       free what caches and old builds take; update runs it" >&2
    case "$ROLE" in
        pc)
            echo "  status                      what only you can do, while it is missing" >&2
            echo "  save                        save Cargo tools and Rex settings into dots" >&2
            echo "  backup                      back up with Time Machine, then unmount its disk" >&2
            ;;
        server)
            echo "  fetch                       build the workloads and download macOS, restarting nothing" >&2
            echo "  status [--check]            this mini's mode, workloads, tunnels, and disk" >&2
            echo "  install [MODE]              install this mini's mode, or MODE: prod, next, a branch, or local" >&2
            echo "  start                       start the workloads that are not running" >&2
            echo "  stop [NAME...]              stop the workloads cleanly: bitcoind bitviewd mcp tunnels" >&2
            echo "  bench [MODE]                run the Bitview benchmark" >&2
            echo "  locate                      play a sound to find this mini" >&2
            ;;
    esac
    exit 1
}

case "$ROLE" in
    pc|server) ;;
    *)
        echo "ship does not know this Mac's role; run ./pc/setup.sh or ./server/setup.sh." >&2
        exit 1
        ;;
esac

command="${1:-}"
[ "$#" -eq 0 ] || shift
case "$ROLE:$command" in
    *:update) exec "$DOTS_DIR/shared/update.sh" "$@" ;;
    *:clean) exec "$DOTS_DIR/shared/clean.sh" "$@" ;;
    pc:status) exec "$DOTS_DIR/pc/status.sh" "$@" ;;
    pc:save) exec "$DOTS_DIR/pc/save.sh" "$@" ;;
    pc:backup) exec "$DOTS_DIR/pc/backup.sh" "$@" ;;
    server:fetch)
        [ "$#" -eq 0 ] || usage
        exec "$DOTS_DIR/shared/update.sh" --fetch
        ;;
    server:status) exec "$DOTS_DIR/server/status.sh" "$@" ;;
    server:install) exec "$DOTS_DIR/server/install.sh" "$@" ;;
    server:start | server:stop | server:boot) exec "$DOTS_DIR/server/workloads.sh" "$command" "$@" ;;
    server:bench) exec "$DOTS_DIR/server/bench.sh" "$@" ;;
    server:locate) exec "$DOTS_DIR/server/locate.sh" "$@" ;;
    *) usage ;;
esac
