#!/usr/bin/env bash
set -euo pipefail

# fleet: the servers, from the workstation, which decides what each runs.
# pc/fleet.conf lists them by their Tailscale names, with their mode and the
# tunnels they share. Cloudflare holds the tunnel tokens, and the git-ignored
# pc/.tunnels keeps them at hand, fetched with cf when missing.
# Each server also serves the tunnel named after it, if there is one, which
# reaches it alone. fleet gives each server its part over tssh, as mini, and
# runs ship there. A server keeps what it was given, so it boots and serves
# without the workstation.
#
#   fleet status [SERVER...]   one line per server, and what differs from fleet.conf
#   fleet update [SERVER...]   bring the servers to the newest version of their mode
#   fleet restart [SERVER...]  stop and start the servers' workloads cleanly
#   fleet tunnels [SERVER...]  give each server a tunnel named after it, with cf
#   fleet purge [SERVER...]    purge Cloudflare's cache of the servers' hostnames
#   fleet auto                 fleet update once a day, when it can; run hourly
#
# A tunnel never serves two versions, and loses no server but to a restart.
# An update pins one version per mode for the whole run, then builds it on
# every server at once while all serve, and only then restarts them, in turn.
# The servers that share a tunnel restart together: each leaves the shared
# tunnels while it restarts, the others still serving them, and the restarted
# ones take them back before the last one leaves. Servers not in prod go
# first, so a bad version shows there before prod, and each must serve again
# before the next.

PC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONF="$PC_DIR/fleet.conf"
TUNNELS="$PC_DIR/.tunnels"
# The servers' ship, its ~ expanded there, by their shell.
# shellcheck disable=SC2088
SHIP='~/Developer/dots/shared/ship'
server_user=mini
tssh="$(command -v tssh)"
# How long a server may take to serve again, a macOS upgrade included.
ready_timeout=$((45 * 60))
# Where a server's own tunnel reaches its site: SERVER.$DOMAIN.
DOMAIN=bitview.space
SITE=http://localhost:3110
export CF_QUIET=1

# cf caches the account in .cloudflare where it runs, so it runs in fleet's
# cache rather than wherever fleet was.
cf() {
    mkdir -p "$HOME/Library/Caches/dots"
    (cd "$HOME/Library/Caches/dots" && command cf "$@")
}

usage() {
    echo "Usage: fleet status | update | restart | tunnels | purge [SERVER...] | auto" >&2
    exit 1
}

# fleet.conf's lines, SERVER MODE TUNNEL..., for the servers given or all.
entries() {
    local server
    if [ "$#" -eq 0 ]; then
        awk '!/^#/ && NF >= 2' "$CONF"
        return
    fi
    for server; do
        awk -v server="$server" '!/^#/ && $1 == server' "$CONF"
    done
}

# The servers that share a tunnel with each other, one group per line, the
# groups not in prod first, each in fleet.conf's order. With servers given,
# only their groups.
groups() {
    local group server
    awk '
        function root(x) { while (parent[x] != x) x = parent[x]; return x }
        !/^#/ && NF >= 2 {
            servers[++count] = $1
            mode[$1] = $2
            parent[$1] = $1
            for (i = 3; i <= NF; i++) {
                if ($i in holder) parent[root($1)] = root(holder[$i])
                else holder[$i] = $1
            }
        }
        END {
            for (i = 1; i <= count; i++) {
                r = root(servers[i])
                if (!(r in members)) order[++groups] = r
                members[r] = members[r] " " servers[i]
            }
            for (prod = 0; prod <= 1; prod++)
                for (g = 1; g <= groups; g++)
                    if ((mode[order[g]] == "prod") == prod) print substr(members[order[g]], 2)
        }' "$CONF" | while read -r group; do
        if [ "$#" -eq 0 ]; then
            echo "$group"
            continue
        fi
        for server; do
            case " $group " in
                *" $server "*) echo "$group"; break ;;
            esac
        done
    done
}

# The tunnels two or more of the servers given share.
shared() {
    entries "$@" | awk '
        { for (i = 3; i <= NF; i++) count[$i]++ }
        END { for (tunnel in count) if (count[tunnel] > 1) printf "%s ", tunnel }'
}

# The tunnels SERVER serves: those fleet.conf gives it, and the one named after
# it, if pc/.tunnels has one.
tunnels_of() {
    local tunnels
    read -r _ _ tunnels < <(entries "$1")
    if awk -v name="$1" '$1 == name { found = 1 } END { exit !found }' "$TUNNELS" 2>/dev/null; then
        tunnels="$tunnels $1"
    fi
    # shellcheck disable=SC2086
    echo $tunnels
}

# fleet hands out tokens by name, so every server must be on the tailnet under
# its fleet.conf name and call itself that. A Mac on the tailnet missing from
# fleet.conf may be a new or renamed server.
check_names() {
    local peers peer server self bad=0
    peers="$("$tssh" --tailscale status --json |
        jq -r '.Peer[]? | select(.OS == "macOS") | .DNSName | split(".")[0]')"
    while read -r server _; do
        if ! grep -qx "$server" <<< "$peers"; then
            echo "$server is not on the tailnet under that name; was it renamed?" >&2
            bad=1
            continue
        fi
        self="$(on "$server" '/opt/homebrew/bin/tailscale status --json' 2>/dev/null |
            jq -r '.Self.DNSName | split(".")[0]' 2>/dev/null || true)"
        if [ -n "$self" ] && [ "$self" != "$server" ]; then
            echo "$server calls itself $self on the tailnet; rename one of them." >&2
            bad=1
        fi
    done < <(entries "$@")
    for peer in $peers; do
        [ -n "$(entries "$peer")" ] || echo "$peer is on the tailnet but not in fleet.conf." >&2
    done
    return "$bad"
}

on() {
    local server="$1"
    shift
    "$tssh" -o BatchMode=yes -o ConnectTimeout=15 "$server_user@$server" "$@" </dev/null
}

wait_serving() {
    local server="$1" waited=0
    until on "$server" "$SHIP status --check" 2>/dev/null; do
        if [ "$waited" -ge "$ready_timeout" ]; then
            echo "$server does not serve again after $((ready_timeout / 60)) minutes; stopping here." >&2
            exit 1
        fi
        sleep 15
        waited=$((waited + 15))
    done
    echo "$server: $(on "$server" "$SHIP status")"
}

# Run COMMAND on SERVER as a job of its own, which finishes there whatever
# happens to this Mac or the connection, as when it sleeps: its output goes to
# ~/Library/Logs/dots/fleet.log and, once it ends, its status beside it, its
# process meanwhile in fleet.pid. A subshell keeps an exit in COMMAND from
# skipping the status.
detach() {
    printf '%s\n' \
        'mkdir -p ~/Library/Logs/dots' \
        'rm -f ~/Library/Logs/dots/fleet.status' \
        "nohup bash -c '( $2 ); echo \$? > ~/Library/Logs/dots/fleet.status' > ~/Library/Logs/dots/fleet.log 2>&1 &" \
        'echo $! > ~/Library/Logs/dots/fleet.pid' |
        "$tssh" -o BatchMode=yes -o ConnectTimeout=15 "$server_user@$1" 'bash -s'
}

# Show the output of the job detach started on SERVER as it comes, through lost
# connections, until it ends, and return its status: a failure when it ended
# without one, as in a restart.
follow_job() {
    local server="$1" shown=0 lines status=''
    while [ -z "$status" ]; do
        sleep 5
        lines="$(on "$server" "tail -n +$((shown + 1)) ~/Library/Logs/dots/fleet.log" 2>/dev/null)" || continue
        status="$(on "$server" "bash -c 'cat ~/Library/Logs/dots/fleet.status 2>/dev/null ||
            kill -0 \$(cat ~/Library/Logs/dots/fleet.pid) 2>/dev/null || echo gone'" 2>/dev/null)" || status=''
        if [ "$status" = gone ]; then
            echo "$server: the job ended without a status." >&2
            status=1
        fi
        # Lines written between the two reads come with the status.
        if [ -n "$status" ]; then
            lines="$(on "$server" "tail -n +$((shown + 1)) ~/Library/Logs/dots/fleet.log" 2>/dev/null)" || true
        fi
        if [ -n "$lines" ]; then
            printf '%s\n' "$lines"
            shown=$((shown + $(printf '%s\n' "$lines" | wc -l)))
        fi
    done
    return "$status"
}

# Silence Cloudflare's tunnel alerts while fleet restarts a server on purpose,
# so that an alert email means something went wrong. Cloudflare silences a
# whole policy, not one tunnel, so a silence lasts only while one server
# restarts, an hour at most, lifted once it serves again. Nested calls share
# the outer silence. Failing to silence costs only the emails.
quiet_depth=0
silences=''
quiet() {
    local start end policy
    quiet_depth=$((quiet_depth + 1))
    [ "$quiet_depth" -eq 1 ] || return 0
    start="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    end="$(date -u -v+1H +%Y-%m-%dT%H:%M:%SZ)"
    for policy in $(cf alerting policies list 2>/dev/null |
        jq -r '.[] | select(.alert_type == "tunnel_health_event") | .id' 2>/dev/null); do
        cf alerting silences create --body "$(jq -nc --arg policy "$policy" --arg start "$start" --arg end "$end" \
            '[{policy_id: $policy, start_time: $start, end_time: $end}]')" >/dev/null 2>&1 || true
    done
    silences="$(cf alerting silences list 2>/dev/null |
        jq -r --arg start "$start" --arg end "$end" '.[] | select(.start_time == $start and .end_time == $end) | .id' \
            2>/dev/null || true)"
}
unquiet() {
    quiet_depth=$((quiet_depth - 1))
    [ "$quiet_depth" -eq 0 ] || return 0
    lift
}
# Lift the silence now, as when fleet stops before a server serves again.
lift() {
    local silence
    for silence in $silences; do
        cf alerting silences delete "$silence" --force >/dev/null 2>&1 || true
    done
    silences=''
}

# Give SERVER the tokens of TUNNEL..., only those, and when that changes
# them, restart its tunnels on them and wait until it serves again.
give_tunnels() {
    local server="$1" tokens tunnel
    shift
    tokens="$(for tunnel; do awk -v name="$tunnel" '$1 == name { print $1, $2 }' "$TUNNELS"; done)"
    if [ "$(on "$server" 'shasum ~/Developer/dots/server/.tokens 2>/dev/null' | cut -d ' ' -f 1)" = \
        "$(printf '%s\n' "$tokens" | shasum | cut -d ' ' -f 1)" ]; then
        return 0
    fi
    echo "$server: serving tunnels ${*:-none}"
    quiet
    printf '%s\n' "$tokens" | "$tssh" -o BatchMode=yes "$server_user@$server" \
        'bash -c "umask 077; cat > ~/Developer/dots/server/.tokens.new && mv ~/Developer/dots/server/.tokens.new ~/Developer/dots/server/.tokens"'
    detach "$server" "$SHIP stop tunnels && $SHIP start"
    follow_job "$server"
    wait_serving "$server"
    unquiet
}

# The versions to install in MODE, bitviewd's and bitview_mcp's, resolved
# once per run: the newest crates.io releases in prod, the branch's commit
# otherwise. None for local, which fleet copies.
resolve() {
    local commit
    case "$1" in
        prod)
            for crate in bitviewd bitview_mcp; do
                curl -s -m 10 -A fleet "https://crates.io/api/v1/crates/$crate" | jq -er '.crate.max_stable_version'
            done | paste -s -d ' ' -
            ;;
        local) ;;
        *)
            commit="$(git ls-remote https://github.com/bitcoinresearchkit/mono "refs/heads/$1" | cut -f 1)"
            [ -n "$commit" ] && echo "$commit $commit"
            ;;
    esac
}

# Ready SERVER... at once, while each still serves: give each its mode and
# the run's versions, in local mode its copy of ~/Developer/mono, and run ship
# fetch there, which builds them and downloads a macOS update, restarting
# nothing. A server that fails stops the run before any restarts.
fetch() {
    local server mode pins note pids=() i failed=0
    echo "== Building on $* at once, while they serve..."
    for server; do
        read -r _ mode _ < <(entries "$server")
        pins="$(cat "$work/pins.$mode")"
        {
            on "$server" 'git -C ~/Developer/dots pull -q --ff-only' &&
                on "$server" "bash -c 'mkdir -p ~/.config/dots && echo $mode $pins > ~/.config/dots/mode'" &&
                if [ "$mode" = local ]; then
                    rsync -a --delete --exclude /target/ -e "$tssh -T" \
                        "$HOME/Developer/mono/" "$server_user@$server:Developer/mono/" </dev/null
                fi &&
                on "$server" "nice -n 10 $SHIP fetch"
        } >"$work/fetch.$server" 2>&1 &
        pids+=("$!")
    done
    i=0
    for server; do
        if wait "${pids[$i]}"; then
            note="$(grep -E '^(macOS .* is downloaded|Could not download macOS .*)\.$' "$work/fetch.$server" | tail -1 || true)"
            echo "$server: built${note:+; $note}"
        else
            echo "$server: failed to build:" >&2
            tail -n 20 "$work/fetch.$server" | sed 's/^/  /' >&2
            failed=1
        fi
        i=$((i + 1))
    done
    if [ "$failed" -eq 1 ]; then
        echo "Stopping before any server restarts." >&2
        exit 1
    fi
}

# Update SERVER, which fetch readied, without the tunnels HELD while others
# still serve them.
update_server() {
    local server="$1" held="$2" mode tunnel give='' pins
    read -r _ mode _ < <(entries "$server")
    for tunnel in $(tunnels_of "$server"); do
        case " $held " in
            *" $tunnel "*) ;;
            *) give="$give $tunnel" ;;
        esac
    done
    pins="$(cat "$work/pins.$mode")"
    echo "== $server: $mode${pins:+ ${pins%% *}}"
    quiet
    # shellcheck disable=SC2086
    give_tunnels "$server" $give

    # From a terminal, ship update runs in it, to ask for macOS's password, and
    # its connection ends early when it restarts Tailscale or the Mac. Without
    # one, as fleet auto runs, it is a job of the server's own, which installs
    # no macOS. Either way, whether the server serves again is what counts.
    if [ -t 0 ]; then
        "$tssh" -t "$server_user@$server" "$SHIP update" || true
        until on "$server" true 2>/dev/null; do
            sleep 15
        done
    else
        detach "$server" "$SHIP update"
        follow_job "$server" || echo "$server: ship update failed; see above." >&2
    fi
    echo "$server: waiting until it serves again..."
    wait_serving "$server"
    unquiet
}

# Whether SERVER already runs PINS, bitviewd's and bitview_mcp's, as the
# builds its workloads recorded at their start say, so updating it restarts
# neither. Never in local mode, which has none.
at_pins() {
    local server="$1" pin mcp_pin running
    read -r pin mcp_pin <<< "$2"
    [ -n "$pin" ] || return 1
    running="$(on "$server" 'cat ~/.config/dots/running/bitviewd ~/.config/dots/running/bitview_mcp' 2>/dev/null)" ||
        return 1
    awk -v pin="$pin" -v mcp_pin="$mcp_pin" '
        function at(p) { return $2 == "v" p ":" || index($0, "rev=" p) }
        $1 == "bitviewd" && at(pin) { found++ }
        $1 == "bitview_mcp" && at(mcp_pin) { found++ }
        END { exit found != 2 }' <<< "$running"
}

# Purge Cloudflare's cache of the hostnames that the tunnels of SERVER...
# route, so none serves what an earlier version left there.
purge() {
    local server tunnel hosts
    hosts="$(for tunnel in $(for server; do tunnels_of "$server"; done | tr ' ' '\n' | sort -u); do
        cf tunnels config get "$(tunnel_id "$tunnel")" | jq -r '.config.ingress[]?.hostname // empty' || exit 1
    done | sort -u)" || return 1
    [ -n "$hosts" ] || return 0
    echo "Purging Cloudflare's cache of" $hosts
    cf cache purge --zone "$DOMAIN" --force --body "$(jq -Rnc '{hosts: [inputs]}' <<< "$hosts")" >/dev/null
}

# Whether SERVER serves: workloads running, tunnels connected, and Bitview at
# the tip, as wait_serving waits for.
serving() {
    on "$1" "$SHIP status --check" 2>/dev/null
}

# SERVER..., those not serving first, as updating or restarting them costs no
# service, each part in the order given.
needing_first() {
    local server up=''
    for server; do
        if serving "$server"; then
            up="$up $server"
        else
            echo "$server"
        fi
    done
    for server in $up; do
        echo "$server"
    done
}

# Stop before taking SERVER down while another of SERVER... does not serve, as
# their shared tunnels would be left without a server.
others_serve() {
    local server="$1" other
    shift
    for other; do
        if [ "$other" != "$server" ] && ! serving "$other"; then
            echo "$other does not serve, so $server is left as it is, serving their tunnels; run fleet again once $other serves." >&2
            exit 1
        fi
    done
}

# Update a group of servers sharing tunnels, so each tunnel serves one
# version at a time, but for a few seconds while the last server hands its
# shared tunnels to the updated ones, then purge their hostnames' cache. A
# group already at the run's versions keeps serving them throughout, and
# keeps its cache.
update_group() {
    local changed='' held='' server other last mode
    # shellcheck disable=SC2046
    set -- $(needing_first "$@")
    last="${*: -1}"
    read -r _ mode _ < <(entries "$1")
    for server; do
        if ! at_pins "$server" "$(cat "$work/pins.$mode")"; then
            changed=1
            held="$(shared "$@")"
            break
        fi
    done
    for server; do
        if [ -n "$held" ] && [ "$server" = "$last" ] && [ "$#" -gt 1 ]; then
            for other; do
                [ "$other" != "$last" ] || continue
                # shellcheck disable=SC2046
                give_tunnels "$other" $(tunnels_of "$other")
            done
        fi
        if serving "$server"; then
            others_serve "$server" "$@"
        fi
        update_server "$server" "$held"
    done
    # shellcheck disable=SC2046
    give_tunnels "$last" $(tunnels_of "$last")
    # A rerun finds the group at its versions and would not purge again.
    if [ -n "$changed" ] && ! purge "$@"; then
        echo "Could not purge their cache; run fleet purge $*" >&2
    fi
}

update() {
    local server mode tunnels tunnel group
    if ! awk '!/^#/ && NF >= 2 {
            for (i = 3; i <= NF; i++) {
                if (($i in m) && m[$i] != $2) {
                    printf "%s is shared by servers in %s and %s; give them one mode.\n", $i, m[$i], $2
                    bad = 1
                }
                m[$i] = $2
            }
        }
        END { exit bad }' "$CONF" >&2; then
        exit 1
    fi
    cf_logged_in
    fetch_tokens
    while read -r server _ tunnels; do
        for tunnel in $tunnels; do
            if [ -z "$(tunnel_id "$tunnel")" ]; then
                echo "fleet.conf gives $server the tunnel $tunnel, which Cloudflare lacks." >&2
                exit 1
            fi
        done
    done < <(entries "$@")

    check_names "$@" || exit 1

    work="$(mktemp -d)"
    trap 'rm -rf "$work"; lift' EXIT
    for mode in $(entries | awk '{ print $2 }' | sort -u); do
        if ! resolve "$mode" > "$work/pins.$mode" || { [ "$mode" != local ] && [ ! -s "$work/pins.$mode" ]; }; then
            echo "Could not find the newest version of $mode." >&2
            exit 1
        fi
    done
    # shellcheck disable=SC2046
    fetch $(groups "$@")
    # On another descriptor, as ssh reads its input: the update's own needs
    # the terminal, for a password.
    while read -r group <&3; do
        # shellcheck disable=SC2086
        update_group $group
    done 3< <(groups "$@")
}

restart() {
    local group server
    trap lift EXIT
    while read -r group; do
        # shellcheck disable=SC2086
        for server in $(needing_first $group); do
            echo "== $server"
            if serving "$server"; then
                # shellcheck disable=SC2086
                others_serve "$server" $group
            fi
            quiet
            on "$server" 'git -C ~/Developer/dots pull -q --ff-only'
            detach "$server" "$SHIP stop && $SHIP start"
            follow_job "$server"
            wait_serving "$server"
            unquiet
        done
    done < <(groups "$@")
}

status() {
    local work server mode tunnels line tunnel versions newest behind version
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' RETURN
    while read -r server _; do
        { on "$server" "$SHIP status" >"$work/$server" 2>/dev/null || echo unreachable >"$work/$server"; } &
    done < <(entries "$@")
    wait
    while read -r server mode _; do
        line="$(cat "$work/$server")"
        printf '%-6s %s\n' "$server" "$line"
        [ "$line" != unreachable ] || continue
        tunnels="$(tunnels_of "$server")"
        if [ "${line%% *}" != "$mode" ] ||
            [ "$(sed -nE 's/.*, tunnels (.*) [0-9]+\/[0-9]+ ready,.*/\1/p' <<< "$line")" != "${tunnels:-none}" ]; then
            printf '%-6s fleet.conf gives it %s with tunnels %s; run fleet update %s\n' \
                '' "$mode" "${tunnels:-none}" "$server"
        fi
        case " $tunnels " in
            *" $server "*) ;;
            *) printf '%-6s has no tunnel of its own; run fleet tunnels %s\n' '' "$server" ;;
        esac
    done < <(entries "$@")
    check_names "$@" || true
    for tunnel in $(shared "$@"); do
        versions="$(entries "$@" | awk -v tunnel="$tunnel" '{ for (i = 3; i <= NF; i++) if ($i == tunnel) print $1 }' |
            while read -r server; do awk '{ print $2 }' "$work/$server"; done | tr -d ',' | sort -u)"
        if [ "$(wc -l <<< "$versions")" -gt 1 ]; then
            echo "$tunnel serves more than one version: $(echo $versions); run fleet update"
        fi
    done
    # A newer version of a mode than its servers have: a crates.io release in
    # prod, a commit of the branch otherwise.
    for mode in $(entries "$@" | awk '$2 != "local" { print $2 }' | sort -u); do
        newest="$(resolve "$mode" 2>/dev/null | cut -d ' ' -f 1)" || continue
        [ -n "$newest" ] || continue
        behind=''
        while read -r server; do
            version="$(awk '{ print $2 }' "$work/$server" | tr -d ',')"
            [ "$version" != unreachable ] || continue
            case "$mode" in
                prod) [ "$version" = "v$newest" ] ;;
                *) [ "${version#*#}" = "${newest:0:8}" ] ;;
            esac || behind="$behind $server"
        done < <(entries "$@" | awk -v mode="$mode" '$2 == mode { print $1 }')
        if [ -n "$behind" ]; then
            echo "$mode has ${newest:0:8}, newer than$behind have; run fleet update"
        fi
    done
}

# cf, with which fleet tunnels changes Cloudflare and fleet update purges its
# cache, must be logged in.
cf_logged_in() {
    if ! cf auth whoami 2>/dev/null | jq -e .authenticated >/dev/null; then
        echo "cf is not logged in; run cf auth login." >&2
        exit 1
    fi
}

# Save in pc/.tunnels each token it lacks of a tunnel fleet.conf names, or
# named after a server, from Cloudflare, which holds them all: pc/.tunnels only
# keeps them at hand, so a new workstation needs no more than cf's login.
fetch_tokens() {
    local list name id token
    list="$(cf tunnels list --is-deleted false)"
    for name in $(awk '!/^#/ && NF >= 2 { for (i = 1; i <= NF; i++) if (i != 2) print $i }' "$CONF" | sort -u); do
        [ -z "$(tunnel_id "$name")" ] || continue
        id="$(jq -r --arg name "$name" '.[] | select(.name == $name) | .id' <<< "$list" | head -1)"
        [ -n "$id" ] || continue
        echo "$name: saving its token, from Cloudflare, in $TUNNELS"
        token="$(cf tunnels token get "$id" | jq -er .)"
        (umask 077; echo "$name $token" >> "$TUNNELS")
    done
}

# The id of the tunnel whose token pc/.tunnels has as NAME, which the token
# holds. Empty without one.
tunnel_id() {
    awk -v name="$1" '$1 == name { print $2 }' "$TUNNELS" 2>/dev/null |
        base64 -d 2>/dev/null | jq -r '.t // empty' 2>/dev/null || true
}

# With Cloudflare's cf, name every tunnel as pc/.tunnels does, and give each
# server a tunnel named after it that routes SERVER.$DOMAIN alone to its site,
# the only name in DNS that points at it, with its token in pc/.tunnels, which
# fleet update then hands out. It changes only what differs, so a rerun
# changes nothing.
tunnels() {
    local list dns name id cf_name server hostname token ingress config target record current
    cf_logged_in
    fetch_tokens
    list="$(cf tunnels list --is-deleted false)"
    dns="$(cf dns records list --zone "$DOMAIN")"

    for name in $(awk '!/^#/ && NF { print $1 }' "$TUNNELS" 2>/dev/null); do
        id="$(tunnel_id "$name")"
        cf_name="$(jq -r --arg id "$id" '.[] | select(.id == $id) | .name' <<< "$list")"
        if [ -z "$cf_name" ]; then
            echo "$TUNNELS has a token for $name, a tunnel Cloudflare no longer has; remove it." >&2
            exit 1
        fi
        if [ "$cf_name" != "$name" ]; then
            echo "$name: renaming its tunnel from $cf_name"
            cf tunnels edit "$id" --name "$name" >/dev/null
        fi
    done

    for server in $(entries "$@" | awk '{ print $1 }'); do
        hostname="$server.$DOMAIN"
        id="$(tunnel_id "$server")"
        if [ -z "$id" ]; then
            id="$(jq -r --arg name "$server" '.[] | select(.name == $name) | .id' <<< "$list" | head -1)"
            if [ -z "$id" ]; then
                echo "$server: creating its tunnel"
                id="$(cf tunnels create --name "$server" --config-source cloudflare | jq -er .id)"
            fi
            echo "$server: saving its token in $TUNNELS"
            token="$(cf tunnels token get "$id" | jq -er .)"
            (umask 077; echo "$server $token" >> "$TUNNELS")
        fi

        ingress="$(jq -nc --arg host "$hostname" --arg site "$SITE" \
            '[{hostname: $host, service: $site}, {service: "http_status:404"}]')"
        config="$(cf tunnels config get "$id" 2>/dev/null | jq -c '.config // {}')" || config=''
        [ -n "$config" ] || config='{}'
        if ! jq -e --argjson ingress "$ingress" \
            '[.ingress[]? | {hostname, service}] == [$ingress[] | {hostname, service}]' <<< "$config" >/dev/null; then
            echo "$server: routing $hostname alone to $SITE"
            cf tunnels config update "$id" \
                --body "$(jq -c --argjson ingress "$ingress" '{config: (.ingress = $ingress)}' <<< "$config")" >/dev/null
        fi

        target="$id.cfargotunnel.com"
        for record in $(jq -r --arg host "$hostname" --arg target "$target" \
            '.[] | select(.content == $target and .name != $host) | "\(.id)=\(.name)"' <<< "$dns"); do
            echo "$server: removing ${record#*=}, which points at its tunnel"
            cf dns records delete "${record%%=*}" --zone "$DOMAIN" --force >/dev/null
        done
        current="$(jq -r --arg host "$hostname" '.[] | select(.name == $host) | "\(.type) \(.content)"' <<< "$dns")"
        case "$current" in
            "CNAME $target") ;;
            '')
                echo "$server: pointing $hostname at its tunnel"
                cf dns records create --zone "$DOMAIN" --body "$(jq -nc --arg host "$hostname" --arg target "$target" \
                    '{type: "CNAME", name: $host, content: $target, proxied: true}')" >/dev/null
                ;;
            *) echo "$hostname already points elsewhere, $current; leaving it." >&2 ;;
        esac
    done
}

# Run fleet update once a day, from the LaunchAgent that runs this hourly: when
# the last run is over 20 hours old, this Mac is on power, and a server answers,
# so a sleeping or travelling Mac runs it later instead. It keeps the Mac awake
# meanwhile and notifies when it fails. Missed days are fine.
auto() {
    local stamp="$HOME/Library/Application Support/dots/fleet-auto" log="$HOME/Library/Logs/fleet-auto.log" now
    now="$(date +%s)"
    [ $((now - $(cat "$stamp" 2>/dev/null || echo 0))) -ge $((20 * 3600)) ] || return 0
    pmset -g batt | grep -q "'AC Power'" || return 0
    on "$(entries | awk '{ print $1; exit }')" true 2>/dev/null || return 0
    mkdir -p "$(dirname "$stamp")"
    echo "$now" > "$stamp"
    # Its log keeps the last 5 to 10 MB.
    if [ "$(stat -f %z "$log" 2>/dev/null || echo 0)" -gt 10485760 ]; then
        tail -c 5242880 "$log" > "$log.new" && mv "$log.new" "$log"
    fi
    echo "== $(date '+%Y-%m-%d %H:%M') fleet update"
    if ! caffeinate -i "$0" update </dev/null; then
        osascript -e 'display notification "See ~/Library/Logs/fleet-auto.log." with title "fleet update failed"' || true
        return 1
    fi
}

[ "$#" -ge 1 ] || usage
command="$1"
shift
for server; do
    [ -n "$(entries "$server")" ] || { echo "$server is not in $CONF." >&2; exit 1; }
done
case "$command" in
    status) status "$@" ;;
    restart) restart "$@" ;;
    tunnels) tunnels "$@" ;;
    auto)
        [ "$#" -eq 0 ] || usage
        auto
        ;;
    purge)
        cf_logged_in
        # shellcheck disable=SC2046
        purge $(entries "$@" | awk '{ print $1 }')
        ;;
    update)
        update "$@"
        ;;
    *) usage ;;
esac
