#!/usr/bin/env bash
set -euo pipefail

# fleet: the servers, from the workstation, which decides what each runs.
# pc/fleet.conf lists them by their Tailscale names, with their mode and the
# tunnels they share. Cloudflare holds the tunnel tokens, and the git-ignored
# pc/.tunnels keeps them at hand, fetched with cf when missing.
# Each server also serves the tunnel named after it, if there is one, which
# reaches it alone. fleet gives each server its part over SSH, as mini, and
# runs ship there. A server keeps what it was given, so it boots and serves
# without the workstation.
#
#   fleet init [SERVER...]     what fleet needs from you, once: the tailnet's and
#                              Cloudflare's logins, each server's own tunnel, its
#                              password, and the Rex app's forwards
#   fleet status [SERVER...]   one line per server, and what differs from fleet.conf
#   fleet update [SERVER...]   bring the servers to the newest version of their mode
#   fleet restart [SERVER...]  stop and start the servers' workloads cleanly
#   fleet reboot [SERVER...]   restart the servers themselves, cleanly, in turn
#   fleet shutdown [SERVER...] turn them off, cleanly, in turn
#   fleet tunnels              give the servers the tunnels fleet.conf gives them,
#                              updating nothing (a tunnel moved in an outage)
#   fleet log [SINCE]          how many servers each tunnel had ready since SINCE,
#                              a day ago by default, at each change, the fewest,
#                              and when below its floor, from their tunnels.log
#   fleet purge [SERVER...]    purge Cloudflare's cache of the servers' hostnames
#   fleet auto                 fleet update, hourly, when this Mac can
#
# A shared tunnel keeps its floor of servers holding it ready, two where
# fleet.conf gives it two or more, one otherwise: a server leaves a tunnel only
# while the others holding it ready, counted just before, number at least that.
# An update pins one version per mode, readies every server at once, then takes
# them in turn, those not in prod first: one that would restart anything leaves
# its tunnels (a stand-in taking one it alone holds), restarts, and takes them
# back (converge), so a mode's versions mix while it rolls. A server that
# cannot get ready, or cannot leave, is left as it is and the run fails; a
# rerun after any stop starts from what the servers hold, with nothing to
# resume.

PC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONF="$PC_DIR/fleet.conf"
TUNNELS="$PC_DIR/.tunnels"
# The servers' ship, its ~ expanded there, by their shell.
# shellcheck disable=SC2088
SHIP='~/Developer/dots/shared/ship'
# shellcheck disable=SC2088
MACOS_UPDATE='~/Developer/dots/shared/macos-update.sh'
# Where fleet lends a server its password for the one job it starts next,
# which reads and deletes it at once.
# shellcheck disable=SC2088
PASSWORD='~/.config/dots/password'
# shellcheck disable=SC2088
JOB='~/Developer/dots/server/job.sh'
# shellcheck disable=SC2088
TAILSCALE_SH='~/Developer/dots/shared/tailscale.sh'
# shellcheck disable=SC2088
TUNNELS_SH='~/Developer/dots/server/tunnels.sh'
server_user=mini
# How long a server may take to serve again: a macOS upgrade, or Bitview
# recomputing what a new version changed, which can take hours.
ready_timeout=$((12 * 3600))
# How long a server may go unanswered while it readies, which restarts
# nothing, so one that stops answering is left out within the hour, rather
# than holding every group's update for 12.
fetch_timeout=3600
# Where a server's own tunnel reaches its site: SERVER.$DOMAIN.
DOMAIN=bitview.space
SITE=http://localhost:3110
export CF_QUIET=1
# Where fleet keeps its state, which a cache cleaner leaves alone: the lock,
# and fleet auto's last success and alerts.
STATE_DIR="$HOME/Library/Application Support/dots"

# cf caches the account in .cloudflare where it runs, so it runs in fleet's
# cache rather than wherever fleet was. Quiet, as on a terminal it prints a
# banner, and without CF_QUIET a spinner.
cf() {
    mkdir -p "$HOME/Library/Caches/dots"
    (cd "$HOME/Library/Caches/dots" && command cf "$@" --quiet)
}

usage() {
    echo "Usage: fleet init | status | update | restart | reboot | shutdown | purge [SERVER...] | tunnels | log [SINCE] | auto" >&2
    exit 1
}

# fleet.conf's lines, SERVER MODE TUNNEL..., for the servers given or all.
entries() {
    local server
    if [ "$#" -eq 0 ]; then
        awk '!/^#/ && NF >= 2' "$CONF"
        return
    fi
    for server; do
        awk -v server="$server" '!/^#/ && $1 == server' "$CONF"
    done
}

# The servers given, or all, in fleet.conf's order, those not in prod first, so
# a bad version shows there before prod.
order() {
    entries "$@" | awk '$2 != "prod" { print $1 }'
    entries "$@" | awk '$2 == "prod" { print $1 }'
}

# The tunnels two or more of the servers given share.
shared() {
    entries "$@" | awk '
        { for (i = 3; i <= NF; i++) count[$i]++ }
        END { for (tunnel in count) if (count[tunnel] > 1) printf "%s ", tunnel }'
}

# Each server of fleet.conf and a tunnel it serves, a line each: those
# fleet.conf gives it, and the one named after it, if pc/.tunnels has one.
serves() {
    awk -v tokens="$TUNNELS" 'BEGIN { while ((getline line < tokens) > 0) { split(line, f, " "); token[f[1]] } }
        !/^#/ && NF >= 2 { for (i = 3; i <= NF; i++) print $1, $i; if ($1 in token) print $1, $1 }' "$CONF"
}
# The tunnels SERVER serves, and the servers that serve TUNNEL.
tunnels_of() {
    serves | awk -v server="$1" '$1 == server { print $2 }' | xargs
}
wanted() {
    serves | awk -v tunnel="$1" '$2 == tunnel { print $1 }'
}

# fleet hands out tokens by name, so every server must be on the tailnet under
# its fleet.conf name and call itself that. A Mac on the tailnet missing from
# fleet.conf may be a new or renamed server.
check_names() {
    local peers peer server self bad=0
    peers="$(tailscale status --json |
        jq -r '.Peer[]? | select(.OS == "macOS") | .DNSName | split(".")[0]')"
    while read -r server _; do
        if ! grep -qx "$server" <<< "$peers"; then
            echo "$server is not on the tailnet under that name; was it renamed?" >&2
            bad=1
            continue
        fi
        self="$(on "$server" '/opt/homebrew/bin/tailscale status --json' 2>/dev/null |
            jq -r '.Self.DNSName | split(".")[0]' 2>/dev/null || true)"
        if [ -n "$self" ] && [ "$self" != "$server" ]; then
            echo "$server calls itself $self on the tailnet; rename one of them." >&2
            bad=1
        fi
    done < <(entries "$@")
    for peer in $peers; do
        [ -n "$(entries "$peer")" ] || echo "$peer is on the tailnet but not in fleet.conf." >&2
    done
    return "$bad"
}

# ssh to SERVER as server_user, never asking, and with keepalives, so a server
# that goes away mid-command, as when it restarts, ends the connection rather
# than leaving it waiting.
ssh_to() {
    local server="$1"
    shift
    ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
        "$server_user@$server" "$@"
}

# Run COMMAND on SERVER, with no input.
on() {
    ssh_to "$@" </dev/null
}

# Wait until SERVER serves again, stopping at once if a workload of its
# crashed meanwhile, which stays down until it is looked at.
wait_serving() {
    local server="$1" start="$SECONDS" status
    while :; do
        status=0
        on "$server" "$SHIP status --check" 2>/dev/null || status=$?
        [ "$status" -ne 0 ] || break
        if [ "$status" -eq 2 ]; then
            echo "$server: a workload crashed and stays down; ship status there says which, and its crash log why. Stopping here." >&2
            exit 1
        fi
        if [ $((SECONDS - start)) -ge "$ready_timeout" ]; then
            echo "$server does not serve again after $((ready_timeout / 3600)) hours; stopping here." >&2
            exit 1
        fi
        sleep 2
    done
    echo "$server: $(on "$server" "$SHIP status")"
}

# Run COMMAND on SERVER as a job of its own, with server/job.sh, which
# finishes there whatever happens to this Mac or the connection, as when it
# sleeps. One at a time: an earlier job still running, as of a run cut short
# here, ends first.
detach() {
    local start="$SECONDS" status waiting=''
    while :; do
        status=0
        on "$1" "$JOB start '$2'" || status=$?
        [ "$status" -eq 3 ] || return "$status"
        [ -n "$waiting" ] || echo "$1: an earlier job of fleet's still runs there; waiting for it to end..."
        waiting=1
        if [ $((SECONDS - start)) -ge "$ready_timeout" ]; then
            echo "$1: an earlier job of fleet's still runs there after $((ready_timeout / 3600)) hours." >&2
            return 1
        fi
        sleep 10
    done
}

# Show the output of the job detach started on SERVER as it comes, through lost
# connections, until it ends, and return its status: a failure when it ended
# without one, as in a restart, or when SERVER stops answering for TIMEOUT
# seconds, by default as long as it may take to serve again.
follow_job() {
    local server="$1" timeout="${2:-$ready_timeout}" shown=0 lines status='' answered="$SECONDS"
    while [ -z "$status" ]; do
        sleep 2
        if ! lines="$(on "$server" "tail -n +$((shown + 1)) ~/Library/Logs/dots/fleet.log" 2>/dev/null)"; then
            if [ $((SECONDS - answered)) -ge "$timeout" ]; then
                if [ "$timeout" -ge 7200 ]; then
                    echo "$server has not answered for $((timeout / 3600)) hours." >&2
                else
                    echo "$server has not answered for $((timeout / 60)) minutes." >&2
                fi
                return 1
            fi
            continue
        fi
        answered="$SECONDS"
        status="$(on "$server" "$JOB status" 2>/dev/null)" || status=''
        if [ "$status" = gone ]; then
            echo "$server: the job ended without a status." >&2
            status=1
        fi
        # Lines written between the two reads come with the status.
        if [ -n "$status" ]; then
            lines="$(on "$server" "tail -n +$((shown + 1)) ~/Library/Logs/dots/fleet.log" 2>/dev/null)" || true
        fi
        if [ -n "$lines" ]; then
            printf '%s\n' "$lines"
            shown=$((shown + $(printf '%s\n' "$lines" | wc -l)))
        fi
    done
    return "$status"
}

# What each server runs and holds now, read from all at once into
# $work/live.SERVER: the mode and build each of its workloads runs, as their
# starts recorded them, then tunnels.sh state. Empty for one that does not
# answer.
probe() {
    local server pids=()
    for server in $(entries | awk '{ print $1 }'); do
        { on "$server" "cat ~/.config/dots/running/bitviewd ~/.config/dots/running/bitview_mcp 2>/dev/null; $TUNNELS_SH state" ||
            : ; } >"$work/live.$server" 2>/dev/null &
        pids+=("$!")
    done
    wait "${pids[@]}"
}

# From the last probe: the version SERVER runs, its builds' records on one
# line, empty when unknown; the tunnels its token file names; whether its
# tunnels serve, rather than wait for its servers; and whether it answered at
# all, as what one that did not holds is unknown, never nothing.
version() {
    sed -n '/^bitview/H; ${ x; s/\n/ /g; s/^ //; p; }' "$work/live.$1"
}
tokens() {
    sed -n 's/^tokens //p' "$work/live.$1"
}
up() {
    grep -qx serving "$work/live.$1"
}
answered() {
    grep -q '^tokens' "$work/live.$1"
}
# Whether SERVER's Bitview and MCP server both started in the mode fleet.conf
# gives it, whatever version: a server moved to another mode there takes no
# tunnel before it runs that mode's builds, and one whose build failed takes
# its tunnels on the last that built.
current() {
    local mode
    mode="$(entries "$1" | awk '{ print $2 }')"
    [ "$(sed -n 's/^mode //p' "$work/live.$1" | paste -sd ' ' -)" = "$mode $mode" ]
}

# The servers whose token file names TUNNEL, and those on which it is in one
# of STATES (ready, lost, draining), from the last probe.
holding() {
    grep -lE "^tokens (.* )?$1( |\$)" "$work"/live.* | sed 's|.*/live\.||' || true
}
in_state() {
    grep -lE "^$1 ($2)\$" "$work"/live.* | sed 's|.*/live\.||' || true
}

# How many servers must keep TUNNEL ready at every step: two where fleet.conf
# gives it two or more, one where it gives it one, none where none.
floor() {
    awk -v tunnel="$1" '!/^#/ && NF >= 2 { for (i = 3; i <= NF; i++) if ($i == tunnel) n++ }
        END { print (n >= 2 ? 2 : n + 0) }' "$CONF"
}

# Give SERVER the tunnels TUNNEL..., only those, and wait until it has taken
# them: those it gains ready, those it drops ended, after their last requests
# (tunnels.sh set). A failure stops the run; a rerun starts again from what
# the servers hold.
give() {
    local server="$1" tunnel
    shift
    if ! answered "$server"; then
        echo "$server did not answer, so what it holds is unknown; stopping here." >&2
        exit 1
    fi
    echo "$server: tunnels ${*:-none}"
    for tunnel; do
        awk -v name="$tunnel" '$1 == name { print $1, $2 }' "$TUNNELS"
    done | ssh_to "$server" "$TUNNELS_SH set $*" || {
        echo "$server did not take the tunnels ${*:-none}; stopping here." >&2
        exit 1
    }
}

# Give each SERVER... the tokens it has with TUNNEL added (ACTION +) or
# removed (-), at once, waiting for all.
give_all() {
    local action="$1" tunnel="$2" server pid pids=() failed=''
    shift 2
    for server; do
        if [ "$action" = + ]; then
            # shellcheck disable=SC2046
            give "$server" $(tokens "$server") "$tunnel" &
        else
            # shellcheck disable=SC2046
            give "$server" $(minus "$(tokens "$server")" "$tunnel") &
        fi
        pids+=("$!")
    done
    for pid in ${pids[@]+"${pids[@]}"}; do
        wait "$pid" || failed=1
    done
    [ -z "$failed" ] || exit 1
}

# Whether TUNNEL keeps its floor without SERVER...: the others holding it
# ready, as the last probe found, number at least its floor. It says why not.
keeps_floor() {
    local tunnel="$1" others need
    shift
    others="$(minus "$(in_state "$tunnel" ready)" "$*" | xargs)"
    need="$(floor "$tunnel")"
    [ "$(wc -w <<< "$others")" -lt "$need" ] || return 0
    echo "$tunnel would be left with ${others:-no server}, below its floor of $need; leaving it on $*." >&2
    return 1
}

# Take every tunnel but its own off SERVER before it stops, each only while it
# keeps its floor without it, counted just before. A tunnel no other server
# holds, as next on m6-2, first gains a stand-in: the first other server whose
# tunnels serve, those fleet.conf gives it first, whatever version it runs,
# as next is shown on prod's meanwhile. A tunnel with a floor of two is never
# stood in for, which would serve it from another mode. SERVER is left as it is,
# failing, while a tunnel would fall below its floor, or when it does not
# answer.
down() {
    local server="$1" tunnel shared stand_in
    probe
    if ! answered "$server"; then
        echo "$server did not answer, so what it holds is unknown." >&2
        return 1
    fi
    shared="$(minus "$(tokens "$server")" "$server" | xargs)"
    for tunnel in $shared; do
        if [ "$(floor "$tunnel")" -ne 1 ] || [ -n "$(minus "$(in_state "$tunnel" ready)" "$server")" ]; then
            continue
        fi
        for stand_in in $(wanted "$tunnel") $(entries | awk '{ print $1 }'); do
            if [ "$stand_in" != "$server" ] && up "$stand_in"; then
                echo "$stand_in: standing in for $server on $tunnel"
                give_all + "$tunnel" "$stand_in"
                probe
                break
            fi
        done
    done
    for tunnel in $shared; do
        keeps_floor "$tunnel" "$server" || return 1
    done
    [ -n "$shared" ] || return 0
    # shellcheck disable=SC2046
    give "$server" $(minus "$(tokens "$server")" "$shared")
    probe
    purge_changed
}

# Make each tunnel's servers those fleet.conf gives it, and $unsettled
# say when some tunnel's servers holding it ready are not those.
converge() {
    local tunnel
    unsettled=''
    probe
    for tunnel in $({ serves | cut -d ' ' -f 2; sed -n 's/^tokens //p' "$work"/live.*; } | xargs -n 1 | sort -u); do
        converge_tunnel "$tunnel"
    done
    purge_changed
}

# Have the run end failing, saying so, when the last converge left some tunnel
# unsettled.
settled() {
    [ -z "$unsettled" ] && return
    echo "Not every tunnel has the servers fleet.conf gives it; see above, and run fleet again." >&2
    incomplete=1
}

# TUNNEL goes to the servers fleet.conf gives it that serve in the mode it
# gives them (current), whatever version, then, while it keeps its floor without
# them, those losing it leave it together.
converge_tunnel() {
    local tunnel="$1" wanted holders server gaining='' losing
    wanted="$(wanted "$tunnel" | xargs)"
    holders="$(holding "$tunnel" | xargs)"
    losing="$(minus "$holders" "$wanted" | xargs)"
    for server in $(minus "$wanted" "$holders"); do
        ! up "$server" || ! current "$server" || gaining="$gaining $server"
    done
    if [ -n "$gaining" ]; then
        # shellcheck disable=SC2086
        give_all + "$tunnel" $gaining
        probe
    fi
    # (Counted again just before, as gaining took time.)
    # shellcheck disable=SC2086
    if [ -n "$losing" ] && keeps_floor "$tunnel" $losing; then
        give_all - "$tunnel" $losing
        probe
    fi
    [ "$(in_state "$tunnel" ready | sort | xargs)" = "$(xargs -n 1 <<< "$wanted" | sort | xargs)" ] || unsettled=1
}

# Purge the cache of each tunnel whose servers, those holding it ready or
# draining, run one version, other than the one its cache was last purged for,
# so none serves what an earlier version left there. The version purged for is
# kept in STATE_DIR, so a run stopped before its purge leaves it to the next.
purge_changed() {
    local tunnel server versions
    mkdir -p "$STATE_DIR/purged"
    for tunnel in $(sed -nE 's/^([^ ]+) (ready|draining)$/\1/p' "$work"/live.* | sort -u); do
        versions="$(for server in $(in_state "$tunnel" 'ready|draining'); do version "$server"; done | sort -u)"
        [ "$(wc -l <<< "$versions")" -eq 1 ] && [ -n "$versions" ] &&
            [ "$versions" != "$(cat "$STATE_DIR/purged/$tunnel" 2>/dev/null)" ] || continue
        if purge "$tunnel"; then
            echo "$versions" > "$STATE_DIR/purged/$tunnel"
        else
            echo "Could not purge the cache of $tunnel; the next run tries again." >&2
            incomplete=1
        fi
    done
}

# Whether PASSWORD is server_user's on SERVER: status 0 when it is, 1 when the
# server refuses it, and 2 when it does not answer, or ssh fails, which says
# nothing of the password.
check_password() {
    local status=0
    printf '%s\n' "$2" | ssh_to "$1" "bash -c 'sudo -S -k -v -p \"\" 2>/dev/null || exit 9'" 2>/dev/null ||
        status=$?
    case "$status" in
        0) return 0 ;;
        9) return 1 ;;
        *) return 2 ;;
    esac
}

# The password this Mac's login keychain keeps as ITEM, exactly: security -w
# gives one that is not plain text, as with an accent, as hex, which -g gives
# too, quoted text otherwise. Nothing without one.
keychain_password() {
    local found
    found="$(security find-generic-password -s "$1" -g 2>&1 >/dev/null)" || return 0
    case "$found" in
        'password: 0x'*) found="${found#password: 0x}"; printf '%s' "${found%% *}" | xxd -r -p ;;
        'password: "'*) found="${found#password: \"}"; printf '%s' "${found%\"}" ;;
    esac
}

# Into the caller's $password, the password this Mac's login keychain keeps
# for server_user on SERVER, checked there: status 0 when it works, 1 when it
# is missing or no longer right, as after a change, and 2 when SERVER does
# not answer.
kept_password() {
    local status=0
    password="$(keychain_password "dots fleet $1")"
    [ -n "$password" ] || return 1
    check_password "$1" "$password" || status=$?
    [ "$status" -ne 0 ] || rm -f "$STATE_DIR/refused.$1"
    return "$status"
}

# When the login keychain last changed ITEM, from its attributes, never its
# password: a password a server refused is the one kept still while this
# says the same.
keychain_changed() {
    security find-generic-password -s "$1" 2>/dev/null | sed -n 's/^ *"mdat"<timedate>=\(0x[0-9A-F]*\).*/\1/p'
}

# Give fleet server_user's password on each SERVER..., or all, from the
# terminal: kept in the login keychain once checked there, and asked for each
# missing or no longer right, trying the one just typed before asking again.
init_passwords() {
    local server password typed='' status
    for server in $(entries "$@" | awk '{ print $1 }'); do
        status=0
        kept_password "$server" || status=$?
        if [ "$status" -eq 1 ]; then
            [ -z "$password" ] || echo "The password kept for $server_user on $server no longer works there."
            if [ -n "$typed" ]; then
                password="$typed"
                status=0
                check_password "$server" "$password" || status=$?
            fi
            if [ "$status" -eq 1 ]; then
                status=0
                ask_password "$server" || status=$?
                typed="$password"
            fi
            [ "$status" -ne 0 ] || keep_password "$server" "$password"
        fi
        case "$status" in
            0) echo "$server: fleet has $server_user's password." ;;
            *) echo "$server does not answer, so its password was not checked." >&2 ;;
        esac
    done
    unset password typed
}

# Check each SERVER...'s password, which fleet init gives, for the jobs that
# need root there: macOS's updates, which ask for it even to download, and
# the Tailscale daemon's. A server whose password is missing or no longer
# right goes without them, and the run ends failing. Those checked are in
# $work/checked. One the server refused is not tried again until fleet init
# keeps another, so a changed password costs it one failed attempt, not one
# an hour. A password lent before that no job read, as when a restart came
# first, goes too.
check_passwords() {
    local server password status refused changed
    for server; do
        refused="$STATE_DIR/refused.$server"
        changed="$(keychain_changed "dots fleet $server")"
        status=0
        if [ -n "$changed" ] && [ "$(cat "$refused" 2>/dev/null)" = "$changed" ]; then
            status=1
        else
            kept_password "$server" || status=$?
        fi
        case "$status" in
            0) echo "$server" >> "$work/checked" ;;
            1)
                if [ -n "$changed" ]; then
                    mkdir -p "$STATE_DIR"
                    echo "$changed" > "$refused"
                fi
                echo "$server: fleet has no password for $server_user there, or no longer the right one; run fleet init." >&2
                incomplete=1
                ;;
            *)
                echo "$server does not answer, so its password was not checked." >&2
                incomplete=1
                ;;
        esac
        on "$server" "rm -f $PASSWORD" 2>/dev/null || true
    done
    unset password
}

# Lend SERVER its password for the job started next, which reads and deletes
# it at once. A new file each time, so the umask sets its mode; the servers
# lent it are in $work/lent, for clear_passwords.
lend_password() {
    local password
    password="$(keychain_password "dots fleet $1")"
    [ -n "$password" ] || return 1
    echo "$1" >> "$work/lent"
    printf '%s\n' "$password" |
        ssh_to "$1" "bash -c 'umask 077; mkdir -p ~/.config/dots && rm -f $PASSWORD && cat > $PASSWORD'"
}

# Ask the terminal for server_user's password on SERVER, unechoed, into the
# caller's $password, until SERVER takes it: status 0 then, and another when
# SERVER does not answer. An empty one is never sent.
ask_password() {
    local tries=0 status
    while [ "$tries" -lt 3 ]; do
        IFS= read -r -s -p "Password of $server_user on $1: " password </dev/tty
        echo
        tries=$((tries + 1))
        if [ -z "$password" ]; then
            echo "No password reached fleet; if you typed one, this terminal did not pass it on." >&2
            continue
        fi
        status=0
        check_password "$1" "$password" || status=$?
        [ "$status" -eq 1 ] || return "$status"
        echo "That is not $server_user's password on $1." >&2
    done
    exit 1
}

# Keep PASSWORD for SERVER in the login keychain, given to security on its
# input, as hex, rather than in its arguments, which any process can read.
keep_password() {
    printf 'add-generic-password -U -s "dots fleet %s" -a %s -X %s\n' "$1" "$server_user" \
        "$(printf '%s' "$2" | xxd -p | tr -d '\n')" | security -i
}

# Remove the password lent to this run's servers where no job read it, as
# when one failed before; one that does not answer keeps it until its next
# run's check, or its boot.
clear_passwords() {
    local server
    [ -e "$work/lent" ] || return 0
    sort -u "$work/lent" | while read -r server; do
        on "$server" "rm -f $PASSWORD" 2>/dev/null || echo "$server: could not remove the password lent it." >&2
    done
}

# The versions to install in MODE, bitviewd's and bitview_mcp's, resolved
# once per run: the newest crates.io releases in release, the branch's commit
# otherwise. None for local, which fleet copies.
resolve() {
    local commit
    case "$1" in
        release)
            # The newest release out for 10 minutes, by when crates.io's index
            # has it everywhere: cargo may not find one just published.
            for crate in bitviewd bitview_mcp; do
                curl -s -m 10 -A fleet "https://crates.io/api/v1/crates/$crate/versions?per_page=50" |
                    jq -er --arg before "$(date -u -v-10M +%Y-%m-%dT%H:%M:%S)" '
                        [.versions[] | select((.yanked | not) and (.num | test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))
                            and .created_at[0:19] < $before)]
                        | max_by(.num | split(".") | map(tonumber)) | .num' || exit 1
            done | paste -s -d ' ' -
            ;;
        local) ;;
        *)
            commit="$(git ls-remote https://github.com/bitcoinresearchkit/mono "refs/heads/$1" | cut -f 1)"
            [ -n "$commit" ] && echo "$commit $commit"
            ;;
    esac
}

# The last of what SERVER's fetch said of a macOS update: downloaded or not.
macos_note() {
    grep -E '^(macOS .* is downloaded|Could not download macOS .*)\.$' "$work/fetch.$1" | tail -1 || true
}

# Download on SERVER the macOS update ship fetch found but could not get
# without the password, lent it, as a job of its own. It never fails the
# fetch: the install downloads it too.
download_macos() {
    grep -q '^Could not download macOS .* without the password' "$work/fetch.$1" || return 0
    grep -qx "$1" "$work/checked" 2>/dev/null || return 0
    if lend_password "$1" && detach "$1" "$MACOS_UPDATE --download"; then
        follow_job "$1" "$fetch_timeout" || true
    fi
}

# Ready SERVER... at once, while each still serves: give each its own address
# if it has its own tunnel (its Bitview names it in each answer from its next
# start, so clients reaching it through a shared hostname stay on it), in local
# mode its copy of ~/Developer/mono, and run ship fetch there in its mode at
# the run's versions, which builds them, recording the mode once they built,
# updates Homebrew, Rust, and Rex, restarting nothing, then download a macOS
# update with its password. Each is a job of the server's own, which finishes
# there whatever happens to this Mac or the connection, as when it sleeps. The servers that fail are listed in
# $work/unready.
fetch() {
    local server mode pins url note pids=() i
    echo "== Readying $* at once, while they serve..."
    for server; do
        read -r _ mode _ < <(entries "$server")
        pins="$(cat "$work/pins.$mode")"
        url=''
        case " $(tunnels_of "$server") " in *" $server "*) url="https://$server.$DOMAIN" ;; esac
        {
            on "$server" 'git -C ~/Developer/dots pull -q --ff-only' &&
                on "$server" "bash -c 'mkdir -p ~/.config/dots && echo $url > ~/.config/dots/public-url'" &&
                if [ "$mode" = local ]; then
                    rsync -a --delete --exclude /target/ -e "ssh -T" \
                        "$HOME/Developer/mono/" "$server_user@$server:Developer/mono/" </dev/null
                fi &&
                detach "$server" "nice -n 10 $SHIP fetch $mode $pins" &&
                follow_job "$server" "$fetch_timeout" &&
                download_macos "$server"
        } >"$work/fetch.$server" 2>&1 &
        pids+=("$!")
    done
    i=0
    for server; do
        if wait "${pids[$i]}"; then
            note="$(macos_note "$server")"
            echo "$server: ready${note:+; $note}"
        else
            echo "$server: failed to get ready:" >&2
            tail -n 20 "$work/fetch.$server" | sed 's/^/  /' >&2
            echo "$server" >> "$work/unready"
        fi
        i=$((i + 1))
    done
}

# Update SERVER, which fetch readied: when ship apply would restart anything, or
# a macOS update waits, its tunnels go first (down), and it is left as it is
# when they cannot. Then ship apply, a job of the server's own, which finishes
# there whatever happens to this Mac or the connection, restarts only what
# runs an older build than the one installed, and starts what is not running.
# Once it serves the run's versions, its Tailscale daemon and macOS update,
# and it takes its tunnels back (converge).
update_server() {
    local server="$1" mode pins pending macos=''
    read -r _ mode _ < <(entries "$server")
    pins="$(cat "$work/pins.$mode")"
    if ! pending="$(on "$server" "$SHIP apply --pending")"; then
        leave "$server" "$server does not answer"
        return 0
    fi
    if grep -qx "$server" "$work/checked" 2>/dev/null && [ -n "$(macos_note "$server")" ]; then
        macos=1
    fi
    echo "== $server: $mode${pins:+ ${pins%% *}}${pending:+, restarting $pending}"
    if [ -n "$pending$macos" ] && ! down "$server"; then
        leave "$server" "$server keeps its tunnels"
        return 0
    fi
    detach "$server" "$SHIP apply"
    if ! follow_job "$server"; then
        echo "$server: ship apply failed; see above. Stopping here." >&2
        exit 1
    fi
    wait_updated "$server"
    update_tailscaled "$server"
    [ -z "$macos" ] || update_macos "$server"
    converge
}

# Wait until SERVER serves again after its update. Serving is not enough: it
# must run the run's versions, or its update did not take.
wait_updated() {
    local server="$1" mode pins
    read -r _ mode _ < <(entries "$server")
    pins="$(cat "$work/pins.$mode")"
    wait_serving "$server"
    probe
    if [ -n "$pins" ] && ! at_pins "$server" "$pins"; then
        echo "$server serves, but not ${pins%% *}; stopping here." >&2
        exit 1
    fi
}

# Bring SERVER's Tailscale daemon onto the tailscaled Homebrew installed, as
# root's copy, when that changes it: with its password lent it, as a job of
# its own, as the restart drops the connection over it, and the job puts back
# what the daemon ran should it not come back. A failure stops the run, as
# the next server could fail the same way.
update_tailscaled() {
    local server="$1" status=0
    on "$server" "$TAILSCALE_SH --check" 2>/dev/null || status=$?
    [ "$status" -eq 1 ] || return 0
    if ! grep -qx "$server" "$work/checked" 2>/dev/null; then
        echo "$server: its Tailscale daemon waits for its password, which fleet init gives." >&2
        incomplete=1
        return 0
    fi
    echo "== $server: Tailscale's daemon"
    if ! lend_password "$server" || ! detach "$server" "$TAILSCALE_SH --update" || ! follow_job "$server"; then
        echo "$server: its Tailscale daemon did not update; see above. Stopping here, as the next server could fail the same way." >&2
        exit 1
    fi
    wait_serving "$server"
}

# Install on SERVER, with its password lent it, the macOS update fetch found,
# as a job of its own, which ends with the restart, and wait until the server
# serves again on it: the run ends failing when it did not update.
update_macos() {
    local server="$1" before
    before="$(on "$server" 'sw_vers -productVersion' || true)"
    if ! lend_password "$server" || ! detach "$server" "$MACOS_UPDATE"; then
        echo "$server: could not start its macOS update." >&2
        incomplete=1
        return 0
    fi
    # The restart ends the job without a status, so that says nothing.
    follow_job "$server" 2>/dev/null || true
    echo "$server: waiting until it serves again..."
    wait_serving "$server"
    if [ "$(on "$server" 'sw_vers -productVersion' || true)" = "$before" ]; then
        echo "$server: macOS did not update; see above." >&2
        incomplete=1
    fi
}

# Whether SERVER runs PINS, bitviewd's and bitview_mcp's, as the builds its
# workloads recorded at their start say, from the last probe. Never in local
# mode, which has none.
at_pins() {
    local pin mcp_pin
    read -r pin mcp_pin <<< "$2"
    [ -n "$pin" ] || return 1
    awk -v pin="$pin" -v mcp_pin="$mcp_pin" '
        function at(p) { return $2 == "v" p ":" || index($0, "rev=" p) }
        $1 == "bitviewd" && at(pin) { found++ }
        $1 == "bitview_mcp" && at(mcp_pin) { found++ }
        END { exit found != 2 }' "$work/live.$1"
}

# Purge Cloudflare's cache of the hostnames that TUNNEL... route, so none
# serves what an earlier version left there.
purge() {
    local tunnel hosts
    hosts="$(for tunnel in $(printf '%s\n' "$@" | sort -u); do
        cf tunnels config get "$(tunnel_id "$tunnel")" | jq -r '.config.ingress[]?.hostname // empty' || exit 1
    done | sort -u)" || return 1
    [ -n "$hosts" ] || return 0
    echo "Purging Cloudflare's cache of" $hosts
    cf cache purge --zone "$DOMAIN" --force --body "$(jq -Rnc '{hosts: [inputs]}' <<< "$hosts")" >/dev/null
}

# One fleet update or restart at a time, as two would take servers down at
# once: another stops with status 3, which fleet auto takes as its hour
# skipped. A lock is held while its process lives, since this Mac last
# started, as a later boot's process may have its number, or for its first
# minute, before the process writes itself in; another is taken over.
LOCK="$STATE_DIR/fleet.lock"
lock() {
    local booted taken
    mkdir -p "$(dirname "$LOCK")"
    if ! mkdir "$LOCK" 2>/dev/null; then
        booted="$(sysctl -n kern.boottime | sed -E 's/^[{] sec = ([0-9]+),.*/\1/')"
        taken="$(stat -f %m "$LOCK" 2>/dev/null || echo 0)"
        if [ "$taken" -ge "$booted" ] && { kill -0 "$(cat "$LOCK/pid" 2>/dev/null)" 2>/dev/null ||
            { [ ! -s "$LOCK/pid" ] && [ $(($(date +%s) - taken)) -lt 60 ]; }; }; then
            echo "Another fleet update or restart runs, as process $(cat "$LOCK/pid" 2>/dev/null); try again once it ends." >&2
            exit 3
        fi
        rm -rf "$LOCK"
        mkdir "$LOCK"
    fi
    echo $$ > "$LOCK/pid"
    trap 'rm -rf "$LOCK"' EXIT
}

# Leave SERVERS as they are, for REASON, and have the run end failing.
incomplete='' unsettled=''
leave() {
    echo "$2; leaving $1 alone." >&2
    incomplete=1
}

# Tell search engines which of the public site's pages this run's prod version
# changed. The first run only notes where it starts, so the site's key is live
# before anything is sent, and a failure waits for the next run: neither
# touches the update.
announce_pages() {
    local new old state="$STATE_DIR/indexnow-prod" script="$HOME/Developer/mono/scripts/indexnow.sh"
    [ -s "$work/pins.prod" ] && [ -x "$script" ] || return 0
    new="$(cut -d ' ' -f 1 "$work/pins.prod")"
    old="$(cat "$state" 2>/dev/null || true)"
    [ "$old" != "$new" ] || return 0
    if [ -z "$old" ] || "$script" "$old" "$new"; then
        mkdir -p "$STATE_DIR"
        echo "$new" > "$state"
    fi
}

update() {
    local server mode tunnels tunnel selected kept=''
    lock
    # The servers given, all by default, which checks before the run cover.
    selected="$(order "$@" | xargs)"
    one_mode || exit 1
    cf_logged_in
    fetch_tokens
    # shellcheck disable=SC2086
    while read -r server _ tunnels; do
        for tunnel in $tunnels; do
            if [ -z "$(tunnel_id "$tunnel")" ]; then
                echo "fleet.conf gives $server the tunnel $tunnel, which Cloudflare lacks." >&2
                exit 1
            fi
        done
    done < <(entries $selected)

    # shellcheck disable=SC2086
    check_names $selected || exit 1

    work="$(mktemp -d)"
    trap 'clear_passwords; rm -rf "$work" "$LOCK"' EXIT
    # shellcheck disable=SC2086
    for mode in $(entries $selected | awk '{ print $2 }' | sort -u); do
        if ! resolve "$mode" > "$work/pins.$mode" || { [ "$mode" != local ] && [ ! -s "$work/pins.$mode" ]; }; then
            echo "Could not find the newest version of $mode." >&2
            rm -f "$work/pins.$mode"
        fi
    done
    for server in $selected; do
        read -r _ mode _ < <(entries "$server")
        if [ ! -e "$work/pins.$mode" ]; then
            leave "$server" "$mode has no version to install"
        # fleet auto leaves alone a server that does not serve, as one stopped
        # on purpose or after a crash, to be looked at.
        elif [ -n "${FLEET_AUTO:-}" ] && ! on "$server" "$SHIP status --check" 2>/dev/null; then
            leave "$server" "$server does not serve, which ship status there explains"
        else
            kept="$kept $server"
        fi
    done
    [ -n "$kept" ] || exit 1
    # shellcheck disable=SC2086
    check_passwords $kept
    # shellcheck disable=SC2086
    fetch $kept
    for server in $kept; do
        if grep -qx "$server" "$work/unready" 2>/dev/null; then
            leave "$server" "$server did not get ready"
        else
            update_server "$server"
        fi
    done
    converge
    settled
    if [ -n "$incomplete" ]; then
        echo "Not everything was updated; see above." >&2
        exit 1
    fi
    announce_pages
}

restart() {
    local server
    lock
    work="$(mktemp -d)"
    trap 'rm -rf "$work" "$LOCK"' EXIT
    for server in $(order "$@"); do
        echo "== $server"
        on "$server" 'git -C ~/Developer/dots pull -q --ff-only'
        if ! down "$server"; then
            leave "$server" "$server keeps its tunnels"
            continue
        fi
        detach "$server" "$SHIP stop && $SHIP start"
        follow_job "$server"
        wait_serving "$server"
        converge
    done
    settled
    [ -z "$incomplete" ]
}

# Reboot or shut down (ACTION) SERVER..., all by default, cleanly, one at a
# time, each as a job of its own with its password lent: its workloads stop
# first (server/power.sh). Its tunnels go first (down), and it is left as it
# is when they cannot. Rebooted, the next goes once it is back: serving again,
# its tunnels taken back, if it served, else answering on a new boot, as a
# mini benching.
power() {
    local action="$1" server served booted
    shift
    lock
    work="$(mktemp -d)"
    trap 'clear_passwords; rm -rf "$work" "$LOCK"' EXIT
    # shellcheck disable=SC2046
    check_passwords $(entries "$@" | awk '{ print $1 }')
    for server in $(order "$@"); do
        grep -qx "$server" "$work/checked" 2>/dev/null || continue
        if ! down "$server"; then
            leave "$server" "$server keeps its tunnels"
            continue
        fi
        served=''
        ! up "$server" || served=1
        echo "== $server: $action"
        booted="$(on "$server" 'sysctl -n kern.boottime' || true)"
        if ! lend_password "$server" || ! detach "$server" "$SHIP $action"; then
            echo "$server: could not start its $action." >&2
            incomplete=1
            continue
        fi
        if [ "$action" = shutdown ]; then
            # (It ends with the mini, which then answers no more.)
            follow_job "$server" 60 2>/dev/null || true
            if on "$server" true 2>/dev/null; then
                echo "$server did not shut down; see above." >&2
                incomplete=1
            else
                echo "$server: off."
            fi
            continue
        fi
        # (A failure ends the job at once; the reboot ends it without a
        # status, which the follow reads once the mini answers again.)
        follow_job "$server" 1800 2>/dev/null || true
        if [ "$(on "$server" 'sysctl -n kern.boottime' 2>/dev/null || true)" = "$booted" ]; then
            echo "$server did not reboot; see above." >&2
            incomplete=1
            continue
        fi
        echo "$server: back."
        [ -z "$served" ] || { wait_serving "$server"; converge; }
    done
    settled
    [ -z "$incomplete" ]
}

# Whether fleet.conf gives each shared tunnel one mode, as two would serve two
# versions; it says which does not.
one_mode() {
    awk '!/^#/ && NF >= 2 {
            for (i = 3; i <= NF; i++) {
                if (($i in m) && m[$i] != $2) {
                    printf "%s is shared by servers in %s and %s; give them one mode.\n", $i, m[$i], $2
                    bad = 1
                }
                m[$i] = $2
            }
        }
        END { exit bad }' "$CONF" >&2
}

# The words of the list A that the list B lacks, one a line.
minus() {
    local word
    for word in $1; do
        case " $2 " in
            *" $word "*) ;;
            *) echo "$word" ;;
        esac
    done
}

# Give the servers the tunnels fleet.conf gives them now, updating nothing, as
# when a tunnel moves to other servers in an outage, or back to a server of
# another mode (converge): a tunnel moved keeps its floor throughout.
retunnel() {
    lock
    one_mode || exit 1
    cf_logged_in
    fetch_tokens
    check_names || exit 1
    work="$(mktemp -d)"
    trap 'rm -rf "$work" "$LOCK"' EXIT
    converge
    settled
    [ -z "$incomplete" ] || exit 1
    echo "Every server has its tunnels."
}

# How many servers held each tunnel of fleet.conf ready since SINCE, an ISO
# time, a day ago by default, from the servers' tunnels.log, merged: TIME
# TUNNEL COUNT at each change, the changes of one second taken together, then
# the fewest and each span below its floor. A server that does not answer is
# left out, said so.
tunnels_log() {
    local since="${1:-$(date -u -v-1d +%Y-%m-%dT%H:%M:%SZ)}" server tunnel floors=''
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    for server in $(entries | awk '{ print $1 }'); do
        # (Each line as the server it came from, whatever name it wrote.)
        on "$server" 'cat ~/Library/Logs/dots/tunnels.log' 2>/dev/null |
            awk -v server="$server" '{ $2 = server; print }' >"$work/$server" ||
            echo "$server does not answer; its log is left out." >&2 &
    done
    wait
    for tunnel in $(entries | awk '{ for (i = 3; i <= NF; i++) print $i }' | sort -u); do
        floors="$floors $tunnel=$(floor "$tunnel")"
    done
    sort "$work"/* | awk -v since="$since" -v floors="$floors" '
        BEGIN { n = split(floors, pairs, " "); for (i = 1; i <= n; i++) { split(pairs[i], kv, "="); floor[kv[1]] = kv[2] } }
        function settle(when) {
            for (t in floor) {
                if ((t in least) && shown[t] == count[t]) continue
                shown[t] = count[t]
                print when, t, count[t] + 0
                if (!(t in least) || count[t] < least[t]) least[t] = count[t] + 0
                if (count[t] < floor[t] && !(t in from)) from[t] = when
                if (count[t] >= floor[t] && (t in from)) { spans[t] = spans[t] "  " from[t] " to " when "\n"; delete from[t] }
            }
        }
        function set(t, server, held) {
            if (!(t in floor) || on[t, server] == held) return
            on[t, server] = held
            count[t] += held ? 1 : -1
        }
        $1 != at { if (at >= since) settle(at); else if ($1 >= since) settle(since); at = $1 }
        $3 == "*" { for (t in floor) set(t, $2, 0); next }
        { set($3, $2, $4 == "connected") }
        END {
            settle(at >= since ? at : since)
            for (t in floor) {
                printf "%s: at least %d since %s, its floor %d\n", t, least[t], since, floor[t]
                if (t in from) spans[t] = spans[t] "  " from[t] " until now\n"
                if (spans[t] != "") printf "  below it:\n%s", spans[t]
            }
        }'
}

status() {
    local work server mode tunnels line tunnel versions newest behind version waiting
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' RETURN
    while read -r server _; do
        { on "$server" "$SHIP status" >"$work/$server" 2>/dev/null || echo unreachable >"$work/$server"; } &
    done < <(entries "$@")
    wait
    while read -r server mode _; do
        line="$(cat "$work/$server")"
        printf '%-6s %s\n' "$server" "$line"
        [ "$line" != unreachable ] || continue
        tunnels="$(tunnels_of "$server")"
        if [ "${line%% *}" != "$mode" ] ||
            [ "$(sed -nE 's/.*, tunnels (.*) [0-9]+\/[0-9]+ ready,.*/\1/p' <<< "$line" | xargs -n 1 | sort | xargs)" != \
                "$(xargs -n 1 <<< "${tunnels:-none}" | sort | xargs)" ]; then
            printf '%-6s fleet.conf gives it %s with tunnels %s; run fleet update %s\n' \
                '' "$mode" "${tunnels:-none}" "$server"
        fi
        case " $tunnels " in
            *" $server "*) ;;
            *) printf '%-6s has no tunnel of its own; run fleet init %s\n' '' "$server" ;;
        esac
        waiting="$(sed -nE 's/.*, macOS [^ ]+ \(([^ ]+) downloaded\).*/\1/p' <<< "$line")"
        if [ -n "$waiting" ]; then
            printf '%-6s has macOS %s downloaded; fleet update installs it\n' '' "$waiting"
        fi
    done < <(entries "$@")
    check_names "$@" || true
    for tunnel in $(shared "$@"); do
        versions="$(entries "$@" | awk -v tunnel="$tunnel" '{ for (i = 3; i <= NF; i++) if ($i == tunnel) print $1 }' |
            while read -r server; do awk '$1 != "unreachable" { print $2 }' "$work/$server"; done | tr -d ',' | sort -u)"
        if [ "$(wc -l <<< "$versions")" -gt 1 ]; then
            echo "$tunnel serves more than one version: $(echo $versions); run fleet update"
        fi
    done
    # A newer version of a mode than its servers have: a crates.io release in
    # release, a commit of the branch otherwise.
    for mode in $(entries "$@" | awk '$2 != "local" { print $2 }' | sort -u); do
        newest="$(resolve "$mode" 2>/dev/null | cut -d ' ' -f 1)" || continue
        [ -n "$newest" ] || continue
        behind=''
        while read -r server; do
            [ "$(cat "$work/$server")" != unreachable ] || continue
            version="$(awk '{ print $2 }' "$work/$server" | tr -d ',')"
            case "$mode" in
                release) [ "$version" = "v$newest" ] ;;
                *) [ "${version#*#}" = "${newest:0:8}" ] ;;
            esac || behind="$behind $server"
        done < <(entries "$@" | awk -v mode="$mode" '$2 == mode { print $1 }')
        if [ -n "$behind" ]; then
            echo "$mode has ${newest:0:8}, newer than$behind have; run fleet update"
        fi
    done
}

# cf, with which fleet init changes Cloudflare and fleet update purges its
# cache, must be logged in.
cf_logged_in() {
    if ! cf auth whoami 2>/dev/null | jq -e .authenticated >/dev/null; then
        echo "cf is not logged in; run fleet init." >&2
        exit 1
    fi
}

# Save in pc/.tunnels each token it lacks of a tunnel fleet.conf names, named
# after a server, or this Mac's own, local, from Cloudflare, which holds them
# all: pc/.tunnels only keeps them at hand, so a new workstation needs no more
# than cf's login.
fetch_tokens() {
    local list='' name id token
    for name in $({ awk '!/^#/ && NF >= 2 { for (i = 1; i <= NF; i++) if (i != 2) print $i }' "$CONF"; echo local; } | sort -u); do
        [ -z "$(tunnel_id "$name")" ] || continue
        # Only when a token is missing, so a run with all of them at hand does
        # without Cloudflare's API.
        [ -n "$list" ] || list="$(cf tunnels list --is-deleted false)"
        id="$(jq -r --arg name "$name" '.[] | select(.name == $name) | .id' <<< "$list" | head -1)"
        [ -n "$id" ] || continue
        echo "$name: saving its token, from Cloudflare, in $TUNNELS"
        token="$(cf tunnels token get "$id" | jq -er .)"
        (umask 077; echo "$name $token" >> "$TUNNELS")
    done
}

# The id of the tunnel whose token pc/.tunnels has as NAME, which the token
# holds. Empty without one.
tunnel_id() {
    awk -v name="$1" '$1 == name { print $2 }' "$TUNNELS" 2>/dev/null |
        base64 -d 2>/dev/null | jq -r '.t // empty' 2>/dev/null || true
}

# With Cloudflare's cf, name every tunnel as pc/.tunnels does, and give each
# SERVER, or each of them, a tunnel named after it that routes SERVER.$DOMAIN
# alone to its site, the only name in DNS that points at it, with its token in
# pc/.tunnels, which fleet update then hands out. It changes only what
# differs, so a rerun changes nothing.
tunnels() {
    local list dns name id cf_name server hostname token ingress config target record current
    cf_logged_in
    fetch_tokens
    list="$(cf tunnels list --is-deleted false)"
    dns="$(cf dns records list --zone "$DOMAIN")"

    for name in $(awk '!/^#/ && NF { print $1 }' "$TUNNELS" 2>/dev/null); do
        id="$(tunnel_id "$name")"
        cf_name="$(jq -r --arg id "$id" '.[] | select(.id == $id) | .name' <<< "$list")"
        if [ -z "$cf_name" ]; then
            echo "$TUNNELS has a token for $name, a tunnel Cloudflare no longer has; remove it." >&2
            exit 1
        fi
        if [ "$cf_name" != "$name" ]; then
            echo "$name: renaming its tunnel from $cf_name"
            cf tunnels edit "$id" --name "$name" >/dev/null
        fi
    done

    for server in $(entries "$@" | awk '{ print $1 }'); do
        hostname="$server.$DOMAIN"
        id="$(tunnel_id "$server")"
        if [ -z "$id" ]; then
            id="$(jq -r --arg name "$server" '.[] | select(.name == $name) | .id' <<< "$list" | head -1)"
            if [ -z "$id" ]; then
                echo "$server: creating its tunnel"
                id="$(cf tunnels create --name "$server" --config-source cloudflare | jq -er .id)"
            fi
            echo "$server: saving its token in $TUNNELS"
            token="$(cf tunnels token get "$id" | jq -er .)"
            (umask 077; echo "$server $token" >> "$TUNNELS")
        fi

        ingress="$(jq -nc --arg host "$hostname" --arg site "$SITE" \
            '[{hostname: $host, service: $site}, {service: "http_status:404"}]')"
        config="$(cf tunnels config get "$id" 2>/dev/null | jq -c '.config // {}')" || config=''
        [ -n "$config" ] || config='{}'
        if ! jq -e --argjson ingress "$ingress" \
            '[.ingress[]? | {hostname, service}] == [$ingress[] | {hostname, service}]' <<< "$config" >/dev/null; then
            echo "$server: routing $hostname alone to $SITE"
            cf tunnels config update "$id" \
                --body "$(jq -c --argjson ingress "$ingress" '{config: (.ingress = $ingress)}' <<< "$config")" >/dev/null
        fi

        target="$id.cfargotunnel.com"
        for record in $(jq -r --arg host "$hostname" --arg target "$target" \
            '.[] | select(.content == $target and .name != $host) | "\(.id)=\(.name)"' <<< "$dns"); do
            echo "$server: removing ${record#*=}, which points at its tunnel"
            cf dns records delete "${record%%=*}" --zone "$DOMAIN" --force >/dev/null
        done
        current="$(jq -r --arg host "$hostname" '.[] | select(.name == $host) | "\(.type) \(.content)"' <<< "$dns")"
        case "$current" in
            "CNAME $target") ;;
            '')
                echo "$server: pointing $hostname at its tunnel"
                cf dns records create --zone "$DOMAIN" --body "$(jq -nc --arg host "$hostname" --arg target "$target" \
                    '{type: "CNAME", name: $host, content: $target, proxied: true}')" >/dev/null
                ;;
            *) echo "$hostname already points elsewhere, $current; leaving it." >&2 ;;
        esac
    done
}

# What fleet needs from you, once, for this Mac or after adding a server to
# fleet.conf, each part only where it is missing, so a rerun changes nothing:
# the tailnet's login, Cloudflare's, each SERVER's own tunnel, or all of
# theirs, mini's password on each, and the Rex app's forwards to them.
init() {
    if [ ! -t 0 ]; then
        echo "fleet init may ask you to log in, and for passwords; run it in a terminal." >&2
        exit 1
    fi
    # Tailscale's daemon, set up and logged in, printing the link to open,
    # when it does not run.
    echo "== The tailnet"
    tailscale status --peers=false 2>/dev/null || "$PC_DIR/../shared/tailscale.sh"
    echo "== Cloudflare"
    if ! cf auth whoami 2>/dev/null | jq -e .authenticated >/dev/null; then
        (cd "$HOME/Library/Caches/dots" && command cf auth login)
    fi
    cf_logged_in
    echo "Logged in."
    echo "== Tunnels"
    tunnels "$@"
    echo "Each server has its own tunnel."
    echo "== Passwords"
    init_passwords "$@"
    echo "== Rex"
    "$PC_DIR/trex"
}

# Run fleet update, hourly, from its LaunchAgent: the one check, which brings
# the servers the newest release or commit of their mode, and Homebrew, Rust,
# Rex, cloudflared, and macOS's updates; a run with nothing new restarts
# nothing. It is this Mac's one hourly job, so it keeps this Mac's tunnel on
# the cloudflared installed too, whatever it skips. Only on power, with this Mac's dots exactly origin's main, which the
# servers pull, and with a server in reach, so a closed or travelling Mac skips its
# hours, and the next one it is open for catches up. It keeps the Mac awake
# meanwhile, logs why it skips an hour, and notifies once when runs start
# failing, or none has run for a day; ship status says when none succeeded for
# over 3 days.

# Notify with TITLE, once until a run succeeds again.
alert() {
    [ ! -e "$STATE_DIR/fleet-auto-failed" ] || return 0
    mkdir -p "$STATE_DIR"
    touch "$STATE_DIR/fleet-auto-failed"
    osascript -e "display notification \"See ~/Library/Logs/fleet-auto.log.\" with title \"$1\"" || true
}

# Skip this hour for REASON, and notify once no run has succeeded for a day.
TIMED_LOCK="$HOME/Developer/brain/bin/m6-2-lock"
# Whether an update would give m6-2 another version than it last built, or
# that is unknown.
timed_moves() {
    local mode given
    read -r mode given < <(on m6-2 'cat ~/.config/dots/mode' 2>/dev/null) || return 0
    [ "$given" != "$(resolve "$mode")" ]
}

overdue() {
    echo "$(date '+%Y-%m-%d %H:%M') skipped: $1"
    if [ $(($(date +%s) - $(cat "$STATE_DIR/fleet-auto" 2>/dev/null || echo 0))) -ge 86400 ]; then
        alert "fleet update has not run for a day"
    fi
}

# Why this Mac's dots, whose fleet runs against the servers, differs from what
# they pull, origin's main, after fetching it; nothing when it does not.
dots_differs() {
    local dots="$1" branch
    git -C "$dots" fetch -q origin main 2>/dev/null || true
    branch="$(git -C "$dots" symbolic-ref -q --short HEAD || echo 'a detached HEAD')"
    if [ -n "$(git -C "$dots" status --porcelain)" ]; then
        echo "dots has uncommitted changes"
    elif [ "$branch" != main ]; then
        echo "dots is on $branch, not main, which the servers pull"
    elif [ "$(git -C "$dots" rev-parse HEAD)" != "$(git -C "$dots" rev-parse origin/main)" ]; then
        echo "dots's main is not origin's, which the servers pull"
    fi
}

auto() {
    local log="$HOME/Library/Logs/fleet-auto.log" dots differs server reachable='' pid long='' status=0
    dots="$(dirname "$PC_DIR")"
    # Its log keeps the last 5 to 10 MB, cut in place, as launchd writes this
    # run's output to the file it opened.
    if [ "$(stat -f %z "$log" 2>/dev/null || echo 0)" -gt 10485760 ]; then
        tail -c 5242880 "$log" > "$log.new" && cat "$log.new" > "$log"
        rm -f "$log.new"
    fi
    # Every hour, even one it skips: this Mac's tunnel, onto a cloudflared
    # upgraded without ship update.
    "$PC_DIR/tunnel.sh" ||
        echo "$(date '+%Y-%m-%d %H:%M') this Mac's tunnel was not moved onto the cloudflared installed"
    if ! pmset -g batt | grep -q "'AC Power'"; then
        echo "$(date '+%Y-%m-%d %H:%M') skipped: on battery"
        return 0
    fi
    differs="$(dots_differs "$dots")"
    if [ -n "$differs" ]; then
        overdue "$differs"
        return 0
    fi
    # Any server in reach, as one down leaves only its group alone.
    for server in $(entries | awk '{ print $1 }'); do
        if on "$server" true 2>/dev/null; then
            reachable="$server"
            break
        fi
    done
    if [ -z "$reachable" ]; then
        overdue "no server answers"
        return 0
    fi
    # m6-2 times runs for others under brain's queued lock: an hour that gives
    # it a new version waits its turn there, a few a day; one that doesn't
    # takes no lock.
    if [ -x "$TIMED_LOCK" ] && timed_moves; then
        if ! "$TIMED_LOCK" take fleet-auto 3000 >/dev/null; then
            overdue "m6-2's timing lock stayed held for 50 minutes"
            return 0
        fi
        trap '"$TIMED_LOCK" release fleet-auto >/dev/null' EXIT
    fi
    echo "== $(date '+%Y-%m-%d %H:%M') fleet update"
    # Watched from here, as launchd starts no other hour's run while this one
    # runs: one that hangs notifies once it has run for a day. Each line it
    # prints is logged with its time, so how long a step took, as a server
    # alone on a tunnel, reads from the log.
    FLEET_AUTO=1 caffeinate -i "$0" update </dev/null \
        > >(while IFS= read -r line; do printf '%s %s\n' "$(date +%T)" "$line"; done) 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [ -z "$long" ] && [ "$SECONDS" -ge 86400 ]; then
            alert "fleet update has run for a day"
            long=1
        fi
        sleep 60
    done
    wait "$pid" || status=$?
    case "$status" in
        0)
            mkdir -p "$STATE_DIR"
            date +%s > "$STATE_DIR/fleet-auto"
            rm -f "$STATE_DIR/fleet-auto-failed"
            ;;
        # Another run holds the lock, as one by hand: this hour's turn, unless
        # that one hangs, which a day without a run says.
        3) overdue "another fleet update or restart runs" ;;
        *)
            alert "fleet update failed"
            return 1
            ;;
    esac
}

[ "$#" -ge 1 ] || usage
command="$1"
shift
[ "$command" = log ] || for server; do
    [ -n "$(entries "$server")" ] || { echo "$server is not in $CONF." >&2; exit 1; }
done
case "$command" in
    init) init "$@" ;;
    status) status "$@" ;;
    restart) restart "$@" ;;
    tunnels)
        [ "$#" -eq 0 ] || usage
        retunnel
        ;;
    log)
        [ "$#" -le 1 ] || usage
        tunnels_log "$@"
        ;;
    reboot | shutdown) power "$command" "$@" ;;
    auto)
        [ "$#" -eq 0 ] || usage
        auto
        ;;
    purge)
        cf_logged_in
        # shellcheck disable=SC2046
        purge $(entries "$@" | while read -r server _; do tunnels_of "$server"; done)
        ;;
    update)
        update "$@"
        ;;
    *) usage ;;
esac
