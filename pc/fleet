#!/usr/bin/env bash
set -euo pipefail

# fleet: the servers, from the workstation, which decides what each runs.
# pc/fleet.conf lists them by their Tailscale names in groups, and the tunnels
# of each role, prod and next. Cloudflare holds the tunnel tokens, and the git-ignored
# pc/.tunnels keeps them at hand, fetched with cf when missing.
# Each server also serves the tunnel named after it, if there is one, which
# reaches it alone. fleet gives each server its part over SSH, as mini, and
# runs ship there. A server keeps what it was given, so it boots and serves
# without the workstation.
#
#   fleet init [SERVER...]     what fleet needs from you, once: the tailnet's and
#                              Cloudflare's logins, each server's own tunnel, its
#                              password, and the Rex app's forwards
#   fleet status [SERVER...]   one line per server, its role, and what differs from fleet.conf
#   fleet role [SERVER]        each server's role now, or SERVER's: prod or next
#   fleet update [SERVER...]   bring the next group to its newest version, and swap
#                              the groups when it serves what prod's branch names
#   fleet restart [SERVER...]  stop and start the servers' workloads cleanly
#   fleet reboot [SERVER...]   restart the servers themselves, cleanly, in turn
#   fleet shutdown [SERVER...] turn them off, cleanly, in turn
#   fleet tunnels              give the servers their roles' tunnels, updating
#                              nothing (a swap due, or after an outage)
#   fleet log [SINCE]          how many servers each tunnel had ready since SINCE,
#                              a day ago by default, at each change, the fewest,
#                              and when below its floor, from their tunnels.log
#   fleet purge [SERVER...]    purge Cloudflare's cache of the servers' hostnames
#   fleet auto                 fleet update, hourly, when this Mac can
#
# One group serves prod and never builds nor restarts: a build beside a
# serving Bitview stalls it (brain notes stalls-20261123). The others serve
# next, and only they build, each server for its own CPU. Prod is the group
# whose servers all serve the commit prod's branch names (assign); promoting
# a commit next runs moves prod's tunnels to that group in seconds (a swap),
# and pushing prod back to what the other group still runs swaps back.
# A shared tunnel keeps its floor of servers holding it ready, a whole group
# for prod's tunnels, one for the others: a server leaves a tunnel only while
# the others holding it ready, counted just before, number at least that. An
# update pins one version per role, readies the next group's servers at once,
# then restarts them in turn, each leaving its tunnels first and taking them
# back (converge). A server that cannot get ready, or cannot leave, is left as
# it is and the run fails; a rerun after any stop starts from what the
# servers hold and run, with nothing to resume.

PC_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONF="$PC_DIR/fleet.conf"
TUNNELS="$PC_DIR/.tunnels"
# The servers' ship, its ~ expanded there, by their shell.
# shellcheck disable=SC2088
SHIP='~/Developer/dots/shared/ship'
# shellcheck disable=SC2088
MACOS_UPDATE='~/Developer/dots/shared/macos-update.sh'
# Where fleet lends a server its password for the one job it starts next,
# which reads and deletes it at once.
# shellcheck disable=SC2088
PASSWORD='~/.config/dots/password'
# shellcheck disable=SC2088
JOB='~/Developer/dots/server/job.sh'
# shellcheck disable=SC2088
TAILSCALE_SH='~/Developer/dots/shared/tailscale.sh'
# shellcheck disable=SC2088
TUNNELS_SH='~/Developer/dots/server/tunnels.sh'
# shellcheck disable=SC2088
AUDITS_SH='~/Developer/dots/server/audits.sh'
server_user=mini
# How long a server may take to serve again: a macOS upgrade, or Bitview
# recomputing what a new version changed, which can take hours.
ready_timeout=$((12 * 3600))
# How long a server restarted on its merged audits may take to serve again: it
# already runs its version, so it recomputes nothing.
audits_timeout=1800
# How long a server may go unanswered while it readies, which restarts
# nothing, so one that stops answering is left out within the hour, rather
# than holding every group's update for 12.
fetch_timeout=3600
# Where a server's own tunnel reaches its site: SERVER.$DOMAIN.
DOMAIN=bitview.space
SITE=http://localhost:3110
export CF_QUIET=1
# Where fleet keeps its state, which a cache cleaner leaves alone: the lock,
# the tunnel cache records, the last swap's time, and fleet auto's last
# success and alerts.
STATE_DIR="$HOME/Library/Application Support/dots"
PURGED="$STATE_DIR/purged"
SWAPPED="$STATE_DIR/swapped"
# How long the group that left prod keeps what it ran, so pushing prod's
# branch back to it swaps back at once, before it builds next's newest.
soak=$((2 * 3600))
# Brain's locks for timed work on a server, LOCKS/SERVER-lock, which fleet
# takes before it builds on, restarts or swaps to a server that has one.
LOCKS="$HOME/Developer/brain/bin"

# cf caches the account in .cloudflare where it runs, so it runs in fleet's
# cache rather than wherever fleet was. Quiet, as on a terminal it prints a
# banner, and without CF_QUIET a spinner.
cf() {
    mkdir -p "$HOME/Library/Caches/dots"
    (cd "$HOME/Library/Caches/dots" && command cf "$@" --quiet)
}

usage() {
    echo "Usage: fleet init | status | update | restart | reboot | shutdown | purge [SERVER...] | role [SERVER] | tunnels | log [SINCE] | auto" >&2
    exit 1
}

# fleet.conf's groups, GROUP SERVER... a line each; its servers, one a line;
# and ROLE's tunnels.
groups() {
    awk '$1 == "group" { $1 = ""; print substr($0, 2) }' "$CONF"
}
servers() {
    awk '$1 == "group" { for (i = 3; i <= NF; i++) print $i }' "$CONF"
}
# The servers given, or all.
given() {
    if [ "$#" -eq 0 ]; then servers; else printf '%s\n' "$@"; fi
}
role_tunnels() {
    awk -v role="$1" '$1 == "role" && $2 == role { for (i = 3; i <= NF; i++) printf "%s ", $i }' "$CONF" | xargs
}

# This run's roles, SERVER ROLE TUNNEL..., the role's tunnels, a line each,
# for the servers given or all: assign writes them.
entries() {
    local server
    if [ "$#" -eq 0 ]; then
        cat "$work/conf"
        return
    fi
    for server; do
        awk -v server="$server" '$1 == server' "$work/conf"
    done
}
role_of() {
    entries "$1" | awk '{ print $2 }'
}

# The servers given, or all, those not in prod first, and in each role those
# with fewer tunnels first, in fleet.conf's order otherwise.
order() {
    entries "$@" | awk '$2 != "prod" { print NF, $1 }' | sort -s -n -k1,1 | cut -d ' ' -f 2
    entries "$@" | awk '$2 == "prod" { print NF, $1 }' | sort -s -n -k1,1 | cut -d ' ' -f 2
}

# Each server and a tunnel it serves, a line each: its role's, and the one
# named after it, if pc/.tunnels has one.
serves() {
    awk -v tokens="$TUNNELS" 'BEGIN { while ((getline line < tokens) > 0) { split(line, f, " "); token[f[1]] } }
        { for (i = 3; i <= NF; i++) print $1, $i; if ($1 in token) print $1, $1 }' "$work/conf"
}
# The tunnels SERVER serves, and the servers that serve TUNNEL.
tunnels_of() {
    serves | awk -v server="$1" '$1 == server { print $2 }' | xargs
}
wanted() {
    serves | awk -v tunnel="$1" '$2 == tunnel { print $1 }'
}

# fleet hands out tokens by name, so every server must be on the tailnet under
# its fleet.conf name and call itself that. A Mac on the tailnet missing from
# fleet.conf may be a new or renamed server.
check_names() {
    local peers peer server self bad=0
    peers="$(tailscale status --json |
        jq -r '.Peer[]? | select(.OS == "macOS") | .DNSName | split(".")[0]')"
    while read -r server _; do
        if ! grep -qx "$server" <<< "$peers"; then
            echo "$server is not on the tailnet under that name; was it renamed?" >&2
            bad=1
            continue
        fi
        self="$(on "$server" '/opt/homebrew/bin/tailscale status --json' 2>/dev/null |
            jq -r '.Self.DNSName | split(".")[0]' 2>/dev/null || true)"
        if [ -n "$self" ] && [ "$self" != "$server" ]; then
            echo "$server calls itself $self on the tailnet; rename one of them." >&2
            bad=1
        fi
    done < <(given "$@")
    for peer in $peers; do
        servers | grep -qx "$peer" || echo "$peer is on the tailnet but not in fleet.conf." >&2
    done
    return "$bad"
}

# ssh to SERVER as server_user, never asking, and with keepalives, so a server
# that goes away mid-command, as when it restarts, ends the connection rather
# than leaving it waiting.
ssh_to() {
    local server="$1"
    shift
    ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
        "$server_user@$server" "$@"
}

# Run COMMAND on SERVER, with no input.
on() {
    ssh_to "$@" </dev/null
}

# Wait until SERVER serves again, at most TIMEOUT seconds, stopping at once if
# a workload of its crashed meanwhile, which stays down until it is looked at.
wait_serving() {
    local server="$1" timeout="${2:-$ready_timeout}" start="$SECONDS" status
    while :; do
        status=0
        on "$server" "$SHIP status --check" 2>/dev/null || status=$?
        [ "$status" -ne 0 ] || break
        if [ "$status" -eq 2 ]; then
            echo "$server: a workload crashed and stays down; ship status there says which, and its crash log why. Stopping here." >&2
            exit 1
        fi
        if [ $((SECONDS - start)) -ge "$timeout" ]; then
            echo "$server does not serve again after $((timeout / 60)) minutes; stopping here." >&2
            exit 1
        fi
        sleep 2
    done
    echo "$server: $(on "$server" "$SHIP status")"
}

# Run COMMAND on SERVER as a job of its own, with server/job.sh, which
# finishes there whatever happens to this Mac or the connection, as when it
# sleeps. One at a time: an earlier job still running, as of a run cut short
# here, ends first.
detach() {
    local start="$SECONDS" status waiting=''
    while :; do
        status=0
        on "$1" "$JOB start '$2'" || status=$?
        [ "$status" -eq 3 ] || return "$status"
        [ -n "$waiting" ] || echo "$1: an earlier job of fleet's still runs there; waiting for it to end..."
        waiting=1
        if [ $((SECONDS - start)) -ge "$ready_timeout" ]; then
            echo "$1: an earlier job of fleet's still runs there after $((ready_timeout / 3600)) hours." >&2
            return 1
        fi
        sleep 10
    done
}

# Show the output of the job detach started on SERVER as it comes, through lost
# connections, until it ends, and return its status: a failure when it ended
# without one, as in a restart, or when SERVER stops answering for TIMEOUT
# seconds, by default as long as it may take to serve again.
follow_job() {
    local server="$1" timeout="${2:-$ready_timeout}" shown=0 lines status='' answered="$SECONDS"
    while [ -z "$status" ]; do
        sleep 2
        if ! lines="$(on "$server" "tail -n +$((shown + 1)) ~/Library/Logs/dots/fleet.log" 2>/dev/null)"; then
            if [ $((SECONDS - answered)) -ge "$timeout" ]; then
                if [ "$timeout" -ge 7200 ]; then
                    echo "$server has not answered for $((timeout / 3600)) hours." >&2
                else
                    echo "$server has not answered for $((timeout / 60)) minutes." >&2
                fi
                return 1
            fi
            continue
        fi
        answered="$SECONDS"
        status="$(on "$server" "$JOB status" 2>/dev/null)" || status=''
        if [ "$status" = gone ]; then
            echo "$server: the job ended without a status." >&2
            status=1
        fi
        # Lines written between the two reads come with the status.
        if [ -n "$status" ]; then
            lines="$(on "$server" "tail -n +$((shown + 1)) ~/Library/Logs/dots/fleet.log" 2>/dev/null)" || true
        fi
        if [ -n "$lines" ]; then
            printf '%s\n' "$lines"
            shown=$((shown + $(printf '%s\n' "$lines" | wc -l)))
        fi
    done
    return "$status"
}

# What each server runs and holds now, read from all at once into
# $work/live.SERVER: the mode and build each of its workloads runs, as their
# starts recorded them, then whether a job of fleet's runs there (a line
# "job " while it does), then tunnels.sh state. Empty for one that does not
# answer. Under the fleet lock, keep each tunnel's observations even if its
# connection has since dropped. It can reconnect with those builds without
# fleet doing anything.
probe() {
    local server file state tunnel status pids=()
    for server in $(servers); do
        { on "$server" "cat ~/.config/dots/running/bitviewd 2>/dev/null; printf 'job '; $JOB status; echo; $TUNNELS_SH state" ||
            : ; } >"$work/live.$server" 2>/dev/null &
        pids+=("$!")
    done
    wait "${pids[@]}"
    : > "$work/serving"
    for file in "$work"/live.*; do
        state="$(serving_state "$file")"
        while read -r tunnel status; do
            [ -z "$locked" ] || remember "$tunnel" "$state"
            printf '%s\t%s\t%s\n' "$tunnel" "$state" "$status" >> "$work/serving"
        done < <(awk '
            /^tokens( |$)/ { for (i = 2; i <= NF; i++) tunnels[$i] }
            NF == 2 && ($2 == "ready" || $2 == "draining") { tunnels[$1] = 1 }
            END { for (t in tunnels) print t, tunnels[t] + 0 }' "$file")
    done
}

# The cache identity from running records. Local builds are named by their
# digests. Older records differ from those with a cache key.
serving_state() {
    awk '
        /^tokens( |$)/ { exit }
        $1 == "bitviewd" && NF > 1 { build = $0 }
        /^cache / { cache = $0 }
        END { if (build) print build (cache ? " " cache : "") }' "$1"
}
# From the last probe: the tunnels SERVER's token file names; whether its
# tunnels serve; and whether it answered, as what it holds is otherwise unknown.
tokens() {
    sed -n 's/^tokens //p' "$work/live.$1"
}
up() {
    grep -qx serving "$work/live.$1"
}
answered() {
    grep -q '^tokens' "$work/live.$1"
}
# Whether SERVER may take TUNNEL: one of prod's only while it runs prod's
# pin, so a server whose build failed or that restarts on another waits;
# any other whatever it runs.
current() {
    case " $(role_tunnels prod) " in
        *" $2 "*) at_pin "$1" "$(cat "$work/pin.prod")" ;;
    esac
}

# Whether a job of fleet's runs on SERVER, and whether brain's lock for timed
# work there is held by another than fleet, from the last probe and the lock.
busy() {
    grep -qx 'job ' "$work/live.$1"
}
held() {
    local state
    [ -x "$LOCKS/$1-lock" ] || return 1
    state="$("$LOCKS/$1-lock" status | head -1)"
    [ "${state#held: }" != "$state" ] && [ "${state#held: fleet-auto }" = "$state" ]
}

# Whether every server of GROUP serves prod's pin, at the tip, with no job of
# fleet's and no hold on it, from the last probe: what prod asks of a group.
qualifies() {
    local server
    for server in $(groups | awk -v group="$1" '$1 == group { $1 = ""; print }'); do
        up "$server" && at_pin "$server" "$(cat "$work/pin.prod")" && ! busy "$server" && ! held "$server" || return 1
    done
}

# Which group serves prod and which next this run, into $work/conf as
# entries() reads it, from the last probe and prod's pin: nothing is kept
# between runs, so an interrupted swap, a rollback (prod's branch moved back)
# and a prod server gone are all read from the servers. The group holding
# prod's tunnels ready on the most servers keeps prod while it qualifies, or
# while no other does; otherwise the first other that does takes it, and
# $swapping says so: converge then moves the tunnels. Every other group is next.
assign() {
    local group servers server tunnel role count most=-1 holder='' prod=''
    tunnel="$(role_tunnels prod | cut -d ' ' -f 1)"
    while read -r group servers; do
        count=0
        for server in $servers; do
            ! grep -qx "$tunnel ready" "$work/live.$server" || count=$((count + 1))
        done
        [ "$count" -le "$most" ] || { most="$count" holder="$group"; }
    done < <(groups)
    if qualifies "$holder"; then
        prod="$holder"
    else
        prod="$(groups | while read -r group _; do
            [ "$group" = "$holder" ] || ! qualifies "$group" || { echo "$group"; break; }
        done)"
    fi
    swapping=''
    if [ -z "$prod" ]; then
        prod="$holder"
    elif [ "$prod" != "$holder" ]; then
        swapping=1
    fi
    while read -r group servers; do
        role=next
        [ "$group" != "$prod" ] || role=prod
        for server in $servers; do
            echo "$server $role $(role_tunnels "$role")"
        done
    done < <(groups) > "$work/conf"
}

# Into $work: prod's pin, what the servers run and hold, then their roles.
roles() {
    if ! resolve prod > "$work/pin.prod"; then
        echo "Could not find prod's commit." >&2
        exit 1
    fi
    probe
    assign
}

# Whether every server in ROLE runs PINS, from the last probe.
all_at() {
    local server
    for server in $(entries | awk -v role="$1" '$2 == role { print $1 }'); do
        at_pin "$server" "$2" || return 1
    done
}

# The servers whose token file names TUNNEL, and those on which it is in one
# of STATES (ready, lost, draining), from the last probe.
holding() {
    grep -lE "^tokens (.* )?$1( |\$)" "$work"/live.* | sed 's|.*/live\.||' || true
}
in_state() {
    grep -lE "^$1 ($2)\$" "$work"/live.* | sed 's|.*/live\.||' || true
}

# How many servers must keep TUNNEL ready at every step: one of prod's, a
# whole group, the smallest; next's, or a server's own, one; any other none.
floor() {
    awk -v tunnel="$1" '
        $1 == "group" { n = NF - 2; if (!least || n < least) least = n; for (i = 3; i <= NF; i++) if ($i == tunnel) own = 1 }
        $1 == "role" { for (i = 3; i <= NF; i++) if ($i == tunnel) role = $2 }
        END { print (role == "prod" ? least : (role != "" || own) ? 1 : 0) }' "$CONF"
}

# Give SERVER the tunnels TUNNEL..., only those, and wait until it has taken
# them: those it gains ready, those it drops ended, after their last requests
# (tunnels.sh set). A failure stops the run; a rerun starts again from what
# the servers hold.
give() {
    local server="$1" tunnel
    shift
    if ! answered "$server"; then
        echo "$server did not answer, so what it holds is unknown; stopping here." >&2
        exit 1
    fi
    echo "$server: tunnels ${*:-none}"
    for tunnel; do
        awk -v name="$tunnel" '$1 == name { print $1, $2 }' "$TUNNELS"
    done | ssh_to "$server" "$TUNNELS_SH set $*" || {
        echo "$server did not take the tunnels ${*:-none}; stopping here." >&2
        exit 1
    }
}

# Give each SERVER... the tokens it has with TUNNEL added (ACTION +) or
# removed (-), at once, waiting for all.
give_all() {
    local action="$1" tunnel="$2" server pid pids=() failed=''
    shift 2
    for server; do
        if [ "$action" = + ]; then
            # shellcheck disable=SC2046
            give "$server" $(tokens "$server") "$tunnel" &
        else
            # shellcheck disable=SC2046
            give "$server" $(minus "$(tokens "$server")" "$tunnel") &
        fi
        pids+=("$!")
    done
    for pid in ${pids[@]+"${pids[@]}"}; do
        wait "$pid" || failed=1
    done
    [ -z "$failed" ] || exit 1
}

# Whether TUNNEL keeps its floor without SERVER...: the others holding it
# ready, as the last probe found, number at least its floor. It says why not.
keeps_floor() {
    local tunnel="$1" others need
    shift
    others="$(minus "$(in_state "$tunnel" ready)" "$*" | xargs)"
    need="$(floor "$tunnel")"
    [ "$(wc -w <<< "$others")" -lt "$need" ] || return 0
    echo "$tunnel would be left with ${others:-no server}, below its floor of $need; leaving it on $*." >&2
    return 1
}

# Take every tunnel but its own off SERVER before it stops, each only while it
# keeps its floor without it, counted just before. SERVER is left as it is,
# failing, when a tunnel would fall below its floor, as prod's always would
# (prod restarts nothing until it is next), or when it does not answer.
down() {
    local server="$1" tunnel shared
    probe
    if ! answered "$server"; then
        echo "$server did not answer, so what it holds is unknown." >&2
        return 1
    fi
    shared="$(minus "$(tokens "$server")" "$server" | xargs)"
    for tunnel in $shared; do
        keeps_floor "$tunnel" "$server" || return 1
    done
    [ -n "$shared" ] || return 0
    # shellcheck disable=SC2046
    give "$server" $(minus "$(tokens "$server")" "$shared")
    probe
    purge_changed
}

# Make each tunnel's servers those their roles give it, and $unsettled
# say when some tunnel's servers holding it ready are not those.
converge() {
    local tunnel
    unsettled=''
    [ -z "$swapping" ] || sync_audits
    probe
    for tunnel in $({ serves | cut -d ' ' -f 2; sed -n 's/^tokens //p' "$work"/live.*; } | xargs -n 1 | sort -u); do
        converge_tunnel "$tunnel"
    done
    purge_changed
}

# Bitview's block audits are each server's observations of its own mempool, so
# they can't be rebuilt from the chain: a server whose data was wiped (a bench,
# a reindex, a fresh mini) holds none. So before prod's tunnels move to another
# group (a promotion or a swap back: every way to prod goes through converge),
# its servers take the history of the servers leaving prod, in one order whose
# last copy wins: the entering servers' stores, then the leaving ones', each
# set with its M4 last (audit_order). The leaving M4 is the canonical recorder.
# That keeps, for every block, the recording of the group that served prod
# when it arrived: the leaving M4 took the whole history this way when its
# group entered prod, then recorded every block since, so its store wins over
# all, and the others fill only the blocks it lacks. Both entering servers
# merge the same copies in the same order, so they hold the same history; a
# block arriving between their restart and the tunnels moving keeps their own.
# Every copy is checked by the entering server's own bitviewd before anything
# stops. Each server then restarts in turn, out of its tunnels, and the
# tunnels move only once both serve again with their copies merged: any
# failure stops the run here, before converge moves prod, which stays on the
# leaving group. A copy that can't be had stops it too, unless its server did
# not answer or holds no store. A rerun after the tunnels began to move finds
# the merge done. A build without the merge (a swap back to one from before
# it) takes prod without the history, saying so loudly.
synced=''
sync_audits() {
    local entering leaving server source i=0
    entering="$(entries | awk '$2 == "prod" { print $1 }' | xargs)"
    [ "$synced" != "$entering" ] || return 0
    synced="$entering"
    for server in $entering; do
        if in_state "$(role_tunnels prod | cut -d ' ' -f 1)" ready | grep -qx "$server"; then
            echo "== Audits: $server already serves prod, so its group merged them in an earlier run."
            return 0
        fi
    done
    for server in $entering; do
        audits "$server" supported && continue
        echo "!! $server's bitviewd has no audit merge: on this build, prod takes NO audit history" \
            "from the group leaving it; the blocks it lacks stay missing there." >&2
        return 0
    done
    # shellcheck disable=SC2046
    leaving="$(minus "$(servers | xargs)" "$entering" | xargs)"
    echo "== Audits: $entering take the history of ${leaving:-no other server}"
    rm -rf "$work/audits"
    mkdir -p "$work/audits"
    # shellcheck disable=SC2046,SC2086
    for source in $(audit_order $entering) $(audit_order $leaving); do
        i=$((i + 1))
        fetch_audits "$source" "$work/audits/$i-$source"
    done
    for server in $entering; do
        stage_audits "$server"
    done
    for server in $entering; do
        restart_audits "$server"
    done
}

# SERVER... in merge order, last wins: the others, then the M4s, the CPU that
# records the canonical audits.
audit_order() {
    printf '%s\n' "$@" | awk '/^m4-/ { last = last " " $0; next } { printf "%s ", $0 } END { print last }' | xargs
}

# Copy SOURCE's audit store into DIR here: a clone there, fetched, removed.
# Tried twice; a source that does not answer (ssh's 255) or holds no store (3)
# is left out, saying so; any other failure stops the run.
fetch_audits() {
    local source="$1" dir="$2" try status
    for try in 1 2; do
        status=0
        audits "$source" clone || status=$?
        case "$status" in
            255) echo "$source does not answer: its audits are left out." >&2; return 0 ;;
            3) echo "$source holds no audits: left out." >&2; return 0 ;;
        esac
        [ "$status" -eq 0 ] && rsync -a "$server_user@$source:/Volumes/External/bitview/mempool/audits-out/" "$dir/" &&
            audits "$source" clear && return 0
        rm -rf "$dir"
        echo "$source: copying its audits failed (try $try of 2)." >&2
    done
    echo "$source answers, but its audits could not be copied; stopping here." >&2
    exit 1
}

# Run server/audits.sh STEP on SERVER, this Mac's copy streamed to it with the
# two scripts it uses, as the servers leaving prod keep the dots they had.
audits() {
    local server="$1"
    shift
    cat "$PC_DIR/../shared/path-guard.sh" "$PC_DIR/../server/external.sh" "$PC_DIR/../server/audits.sh" |
        ssh_to "$server" bash -s -- "$@"
}

# Put the copies on SERVER and have its own bitviewd check each, saying how
# many audits each holds; a copy that fails is fetched again once from its
# source, and a second failure stops the run.
stage_audits() {
    local server="$1" copy name stage="/Volumes/External/bitview/mempool/audits-stage"
    audits "$server" clear || { echo "$server: could not clear its audit stage; stopping here." >&2; exit 1; }
    rsync -a "$work/audits/" "$server_user@$server:$stage/" ||
        { echo "$server: could not take the audit copies; stopping here." >&2; exit 1; }
    for copy in "$work"/audits/*; do
        [ -e "$copy" ] || continue
        name="${copy##*/}"
        audits "$server" check "$name" && continue
        echo "$server: the copy of ${name#*-}'s audits fails its check; fetching it again." >&2
        fetch_audits "${name#*-}" "$copy"
        if ! { [ -d "$copy" ] && rsync -a --delete "$copy/" "$server_user@$server:$stage/$name/" &&
            audits "$server" check "$name"; }; then
            echo "$server: the copy of ${name#*-}'s audits fails again; stopping here." >&2
            exit 1
        fi
    done
}

# What SERVER holds as a server of next: next's tunnels and its own.
as_next() {
    awk -v server="$1" '$1 == server { print $1 }' "$TUNNELS"
    role_tunnels next
}

# Restart SERVER, out of its tunnels, on its staged copies, as a job there,
# and give it next's tunnels and its own back once it serves with them merged,
# saying how long it took to serve again. It takes them first too: a run cut
# short in an earlier restart can leave the other entering server out of
# next, and then this one could never leave it.
restart_audits() {
    local server="$1" other start
    probe
    for other in $(entries | awk '$2 == "prod" { print $1 }'); do
        # shellcheck disable=SC2046
        ! up "$other" || give "$other" $(as_next "$other")
    done
    probe
    down "$server" || { echo "$server keeps its tunnels, so it can't restart on its audits; stopping here." >&2; exit 1; }
    # (Its place step runs in the job, from its own dots, up to date as fleet restart makes it.)
    on "$server" 'git -C ~/Developer/dots pull -q --ff-only' ||
        { echo "$server: could not update its dots; stopping here." >&2; exit 1; }
    start="$SECONDS"
    detach "$server" "$SHIP stop bitviewd && $AUDITS_SH place && $SHIP start"
    follow_job "$server" || { echo "$server: its restart on the audits failed; stopping here." >&2; exit 1; }
    wait_serving "$server" "$audits_timeout"
    audits "$server" merged || { echo "$server serves without having merged its audits; stopping here." >&2; exit 1; }
    echo "$server: serving again $((SECONDS - start)) s after its stop, its audits merged"
    probe
    # shellcheck disable=SC2046
    give "$server" $(as_next "$server")
    probe
}

# Have the run end failing, saying so, when the last converge left some tunnel
# unsettled.
settled() {
    [ -z "$unsettled" ] && return
    echo "Not every tunnel has the servers its role gives it; see above, and run fleet again." >&2
    incomplete=1
}

# TUNNEL goes to the servers whose role gives it that serve and may take it
# (current), then, while it keeps its floor without them, those losing it
# leave it together.
converge_tunnel() {
    local tunnel="$1" wanted holders server gaining='' losing
    wanted="$(wanted "$tunnel" | xargs)"
    holders="$(holding "$tunnel" | xargs)"
    losing="$(minus "$holders" "$wanted" | xargs)"
    for server in $(minus "$wanted" "$holders"); do
        ! up "$server" || ! current "$server" "$tunnel" || gaining="$gaining $server"
    done
    if [ -n "$gaining" ]; then
        # shellcheck disable=SC2086
        give_all + "$tunnel" $gaining
        probe
    fi
    # (Counted again just before, as gaining took time.)
    # shellcheck disable=SC2086
    if [ -n "$losing" ] && keeps_floor "$tunnel" $losing; then
        give_all - "$tunnel" $losing
        probe
    fi
    [ "$(in_state "$tunnel" ready | sort | xargs)" = "$(xargs -n 1 <<< "$wanted" | sort | xargs)" ] || unsettled=1
}

# All writes happen under the fleet lock. Rename within the state directory
# so a killed run leaves either the previous record or the whole new one.
write_purge_record() {
    if ! { mkdir -p "$PURGED" && printf '%s\n' "$2" > "$PURGED/.new.$$" && mv -f "$PURGED/.new.$$" "$PURGED/$1"; }; then
        echo "Could not save the cache record for $1; stopping here." >&2
        exit 1
    fi
}

# One different identity is enough to require a purge, even if the tunnel
# later returns to the old identity. A missing record already needs a purge.
remember() {
    local tunnel="$1" state="$2" previous
    [ -n "$state" ] && read -r previous 2>/dev/null < "$PURGED/$tunnel" || return 0
    [ -z "$previous" ] || [ "$previous" = pending ] || [ "$previous" = "$state" ] ||
        write_purge_record "$tunnel" pending
}

# Purge once a tunnel serves and its holders report one known identity. A
# failed purge leaves the record pending and is attempted again on a new run.
purge_changed() {
    local tunnel state previous server
    while IFS=$'\t' read -r tunnel state; do
        [ -n "$state" ] && [ ! -e "$work/failed-purge.$tunnel" ] || continue
        if read -r previous 2>/dev/null < "$PURGED/$tunnel" && [ "$previous" = "$state" ]; then continue; fi
        for server in $(wanted "$tunnel"); do
            answered "$server" && continue
            echo "Skipping the cache purge of $tunnel because $server did not answer." >&2
            incomplete=1
            continue 2
        done
        if purge "$tunnel"; then
            write_purge_record "$tunnel" "$state"
        else
            echo "Could not purge the cache of $tunnel; the next run tries again." >&2
            : > "$work/failed-purge.$tunnel"
            incomplete=1
        fi
    done < <(awk -F '\t' '
        $1 in states && states[$1] != $2 { mixed[$1] = 1 }
        { states[$1] = $2; if ($3) serving[$1] = 1 }
        END { for (t in serving) if (!(t in mixed)) print t "\t" states[t] }' "$work/serving")
}

# Whether PASSWORD is server_user's on SERVER: status 0 when it is, 1 when the
# server refuses it, and 2 when it does not answer, or ssh fails, which says
# nothing of the password.
check_password() {
    local status=0
    printf '%s\n' "$2" | ssh_to "$1" "bash -c 'sudo -S -k -v -p \"\" 2>/dev/null || exit 9'" 2>/dev/null ||
        status=$?
    case "$status" in
        0) return 0 ;;
        9) return 1 ;;
        *) return 2 ;;
    esac
}

# The password this Mac's login keychain keeps as ITEM, exactly: security -w
# gives one that is not plain text, as with an accent, as hex, which -g gives
# too, quoted text otherwise. Nothing without one.
keychain_password() {
    local found
    found="$(security find-generic-password -s "$1" -g 2>&1 >/dev/null)" || return 0
    case "$found" in
        'password: 0x'*) found="${found#password: 0x}"; printf '%s' "${found%% *}" | xxd -r -p ;;
        'password: "'*) found="${found#password: \"}"; printf '%s' "${found%\"}" ;;
    esac
}

# Into the caller's $password, the password this Mac's login keychain keeps
# for server_user on SERVER, checked there: status 0 when it works, 1 when it
# is missing or no longer right, as after a change, and 2 when SERVER does
# not answer.
kept_password() {
    local status=0
    password="$(keychain_password "dots fleet $1")"
    [ -n "$password" ] || return 1
    check_password "$1" "$password" || status=$?
    [ "$status" -ne 0 ] || rm -f "$STATE_DIR/refused.$1"
    return "$status"
}

# When the login keychain last changed ITEM, from its attributes, never its
# password: a password a server refused is the one kept still while this
# says the same.
keychain_changed() {
    security find-generic-password -s "$1" 2>/dev/null | sed -n 's/^ *"mdat"<timedate>=\(0x[0-9A-F]*\).*/\1/p'
}

# Give fleet server_user's password on each SERVER..., or all, from the
# terminal: kept in the login keychain once checked there, and asked for each
# missing or no longer right, trying the one just typed before asking again.
init_passwords() {
    local server password typed='' status
    for server in $(given "$@"); do
        status=0
        kept_password "$server" || status=$?
        if [ "$status" -eq 1 ]; then
            [ -z "$password" ] || echo "The password kept for $server_user on $server no longer works there."
            if [ -n "$typed" ]; then
                password="$typed"
                status=0
                check_password "$server" "$password" || status=$?
            fi
            if [ "$status" -eq 1 ]; then
                status=0
                ask_password "$server" || status=$?
                typed="$password"
            fi
            [ "$status" -ne 0 ] || keep_password "$server" "$password"
        fi
        case "$status" in
            0) echo "$server: fleet has $server_user's password." ;;
            *) echo "$server does not answer, so its password was not checked." >&2 ;;
        esac
    done
    unset password typed
}

# Check each SERVER...'s password, which fleet init gives, for the jobs that
# need root there: macOS's updates, which ask for it even to download, and
# the Tailscale daemon's. A server whose password is missing or no longer
# right goes without them, and the run ends failing. Those checked are in
# $work/checked. One the server refused is not tried again until fleet init
# keeps another, so a changed password costs it one failed attempt, not one
# an hour. A password lent before that no job read, as when a restart came
# first, goes too.
check_passwords() {
    local server password status refused changed
    for server; do
        refused="$STATE_DIR/refused.$server"
        changed="$(keychain_changed "dots fleet $server")"
        status=0
        if [ -n "$changed" ] && [ "$(cat "$refused" 2>/dev/null)" = "$changed" ]; then
            status=1
        else
            kept_password "$server" || status=$?
        fi
        case "$status" in
            0) echo "$server" >> "$work/checked" ;;
            1)
                if [ -n "$changed" ]; then
                    mkdir -p "$STATE_DIR"
                    echo "$changed" > "$refused"
                fi
                echo "$server: fleet has no password for $server_user there, or no longer the right one; run fleet init." >&2
                incomplete=1
                ;;
            *)
                echo "$server does not answer, so its password was not checked." >&2
                incomplete=1
                ;;
        esac
        on "$server" "rm -f $PASSWORD" 2>/dev/null || true
    done
    unset password
}

# Lend SERVER its password for the job started next, which reads and deletes
# it at once. A new file each time, so the umask sets its mode; the servers
# lent it are in $work/lent, for clear_passwords.
lend_password() {
    local password
    password="$(keychain_password "dots fleet $1")"
    [ -n "$password" ] || return 1
    echo "$1" >> "$work/lent"
    printf '%s\n' "$password" |
        ssh_to "$1" "bash -c 'umask 077; mkdir -p ~/.config/dots && rm -f $PASSWORD && cat > $PASSWORD'"
}

# Ask the terminal for server_user's password on SERVER, unechoed, into the
# caller's $password, until SERVER takes it: status 0 then, and another when
# SERVER does not answer. An empty one is never sent.
ask_password() {
    local tries=0 status
    while [ "$tries" -lt 3 ]; do
        IFS= read -r -s -p "Password of $server_user on $1: " password </dev/tty
        echo
        tries=$((tries + 1))
        if [ -z "$password" ]; then
            echo "No password reached fleet; if you typed one, this terminal did not pass it on." >&2
            continue
        fi
        status=0
        check_password "$1" "$password" || status=$?
        [ "$status" -eq 1 ] || return "$status"
        echo "That is not $server_user's password on $1." >&2
    done
    exit 1
}

# Keep PASSWORD for SERVER in the login keychain, given to security on its
# input, as hex, rather than in its arguments, which any process can read.
keep_password() {
    printf 'add-generic-password -U -s "dots fleet %s" -a %s -X %s\n' "$1" "$server_user" \
        "$(printf '%s' "$2" | xxd -p | tr -d '\n')" | security -i
}

# Remove the password lent to this run's servers where no job read it, as
# when one failed before; one that does not answer keeps it until its next
# run's check, or its boot.
clear_passwords() {
    local server
    [ -e "$work/lent" ] || return 0
    sort -u "$work/lent" | while read -r server; do
        on "$server" "rm -f $PASSWORD" 2>/dev/null || echo "$server: could not remove the password lent it." >&2
    done
}

# The version to install from BRANCH, its commit, resolved once per run.
resolve() {
    local commit
    commit="$(git ls-remote https://github.com/bitcoinresearchkit/mono "refs/heads/$1" | cut -f 1)"
    [ -n "$commit" ] && echo "$commit"
}

# The last of what SERVER's fetch said of a macOS update: downloaded or not.
macos_note() {
    grep -E '^(macOS .* is downloaded|Could not download macOS .*)\.$' "$work/fetch.$1" | tail -1 || true
}

# Download on SERVER the macOS update ship fetch found but could not get
# without the password, lent it, as a job of its own. It never fails the
# fetch: the install downloads it too.
download_macos() {
    grep -q '^Could not download macOS .* without the password' "$work/fetch.$1" || return 0
    grep -qx "$1" "$work/checked" 2>/dev/null || return 0
    if lend_password "$1" && detach "$1" "$MACOS_UPDATE --download"; then
        follow_job "$1" "$fetch_timeout" || true
    fi
}

# Ready SERVER... at once, while each still serves: give each its own address
# if it has its own tunnel (its Bitview names it in each answer from its next
# start, so clients reaching it through a shared hostname stay on it), and run
# ship fetch there in its role at the run's versions, which builds them natively,
# recording them once they built,
# updates Homebrew, Rust, and Rex, restarting nothing, then download a macOS
# update with its password. Each is a job of the server's own, which finishes
# there whatever happens to this Mac or the connection, as when it sleeps. The
# servers that fail are listed in $work/unready.
fetch() {
    local server mode pin url note pids=() i
    echo "== Readying $* at once, while they serve..."
    for server; do
        read -r _ mode _ < <(entries "$server")
        pin="$(cat "$work/pin.$mode")"
        url=''
        case " $(tunnels_of "$server") " in *" $server "*) url="https://$server.$DOMAIN" ;; esac
        {
            on "$server" 'git -C ~/Developer/dots pull -q --ff-only' &&
                on "$server" "bash -c 'mkdir -p ~/.config/dots && echo $url > ~/.config/dots/public-url'" &&
                detach "$server" "nice -n 10 $SHIP fetch $mode $pin" &&
                follow_job "$server" "$fetch_timeout" &&
                download_macos "$server"
        } >"$work/fetch.$server" 2>&1 &
        pids+=("$!")
    done
    i=0
    for server; do
        if wait "${pids[$i]}"; then
            note="$(macos_note "$server")"
            echo "$server: ready${note:+; $note}"
        else
            echo "$server: failed to get ready:" >&2
            tail -n 20 "$work/fetch.$server" | sed 's/^/  /' >&2
            echo "$server" >> "$work/unready"
        fi
        i=$((i + 1))
    done
}

# Update SERVER, which fetch readied: when ship apply would restart anything, or
# a macOS update waits, its tunnels go first (down), and it is left as it is
# when they cannot. Then ship apply, a job of the server's own, which finishes
# there whatever happens to this Mac or the connection, restarts only what
# runs an older build than the one installed, and starts what is not running.
# Once it serves the run's version, its Tailscale daemon and macOS update,
# and it takes its tunnels back (converge).
update_server() {
    local server="$1" mode pin pending macos=''
    read -r _ mode _ < <(entries "$server")
    pin="$(cat "$work/pin.$mode")"
    if ! pending="$(on "$server" "$SHIP apply --pending")"; then
        leave "$server" "$server does not answer"
        return 0
    fi
    if grep -qx "$server" "$work/checked" 2>/dev/null && [ -n "$(macos_note "$server")" ]; then
        macos=1
    fi
    echo "== $server: $mode${pin:+ $pin}${pending:+, restarting $pending}"
    if [ -n "$pending$macos" ] && ! down "$server"; then
        leave "$server" "$server keeps its tunnels"
        return 0
    fi
    detach "$server" "$SHIP apply"
    if ! follow_job "$server"; then
        echo "$server: ship apply failed; see above. Stopping here." >&2
        exit 1
    fi
    wait_updated "$server"
    update_tailscaled "$server"
    [ -z "$macos" ] || update_macos "$server"
    converge
}

# Wait until SERVER serves again after its update. Serving is not enough: it
# must run the run's version, or its update did not take.
wait_updated() {
    local server="$1" mode pin
    read -r _ mode _ < <(entries "$server")
    pin="$(cat "$work/pin.$mode")"
    wait_serving "$server"
    probe
    if [ -n "$pin" ] && ! at_pin "$server" "$pin"; then
        echo "$server serves, but not $pin; stopping here." >&2
        exit 1
    fi
}

# Bring SERVER's Tailscale daemon onto the tailscaled Homebrew installed, as
# root's copy, when that changes it: with its password lent it, as a job of
# its own, as the restart drops the connection over it, and the job puts back
# what the daemon ran should it not come back. A failure stops the run, as
# the next server could fail the same way.
update_tailscaled() {
    local server="$1" status=0
    on "$server" "$TAILSCALE_SH --check" 2>/dev/null || status=$?
    [ "$status" -eq 1 ] || return 0
    if ! grep -qx "$server" "$work/checked" 2>/dev/null; then
        echo "$server: its Tailscale daemon waits for its password, which fleet init gives." >&2
        incomplete=1
        return 0
    fi
    echo "== $server: Tailscale's daemon"
    if ! lend_password "$server" || ! detach "$server" "$TAILSCALE_SH --update" || ! follow_job "$server"; then
        echo "$server: its Tailscale daemon did not update; see above. Stopping here, as the next server could fail the same way." >&2
        exit 1
    fi
    wait_serving "$server"
}

# Install on SERVER, with its password lent it, the macOS update fetch found,
# as a job of its own, which ends with the restart, and wait until the server
# serves again on it: the run ends failing when it did not update.
update_macos() {
    local server="$1" before
    before="$(on "$server" 'sw_vers -productVersion' || true)"
    if ! lend_password "$server" || ! detach "$server" "$MACOS_UPDATE"; then
        echo "$server: could not start its macOS update." >&2
        incomplete=1
        return 0
    fi
    # The restart ends the job without a status, so that says nothing.
    follow_job "$server" 2>/dev/null || true
    echo "$server: waiting until it serves again..."
    wait_serving "$server"
    if [ "$(on "$server" 'sw_vers -productVersion' || true)" = "$before" ]; then
        echo "$server: macOS did not update; see above." >&2
        incomplete=1
    fi
}

# Whether SERVER runs PIN, as the build its Bitview recorded at its start says,
# from the last probe.
at_pin() {
    [ -n "$2" ] || return 1
    awk -v pin="$2" '$1 == "bitviewd" && index($0, "rev=" pin) { found = 1 } END { exit !found }' "$work/live.$1"
}

# Purge Cloudflare's cache of the hostnames that TUNNEL... route, so none
# serves what an earlier version left there.
purge() {
    local tunnel hosts
    hosts="$(for tunnel in $(printf '%s\n' "$@" | sort -u); do
        if ! cf tunnels config get "$(tunnel_id "$tunnel")" |
            jq -ers '.[] | .config.ingress[]? | .hostname? | strings | select(length > 0)'; then
            echo "Could not get ingress hostnames for $tunnel." >&2
            exit 1
        fi
    done | sort -u)" || return 1
    [ -n "$hosts" ] || return 1
    echo "Purging Cloudflare's cache of" $hosts
    # cf checks the API envelope before unwrapping it to the purge receipt.
    cf cache purge --zone "$DOMAIN" --force --body "$(jq -Rnc '{hosts: [inputs]}' <<< "$hosts")" |
        jq -es 'length == 1 and (.[0].id | type == "string" and length > 0)' >/dev/null
}

# One fleet update or restart at a time, as two would take servers down at
# once: another stops with status 3, which fleet auto takes as its hour
# skipped. A lock is held while its process lives, since this Mac last
# started, as a later boot's process may have its number, or for its first
# minute, before the process writes itself in; another is taken over.
LOCK="$STATE_DIR/fleet.lock"
lock() {
    local booted taken
    mkdir -p "$(dirname "$LOCK")"
    if ! mkdir "$LOCK" 2>/dev/null; then
        booted="$(sysctl -n kern.boottime | sed -E 's/^[{] sec = ([0-9]+),.*/\1/')"
        taken="$(stat -f %m "$LOCK" 2>/dev/null || echo 0)"
        if [ "$taken" -ge "$booted" ] && { kill -0 "$(cat "$LOCK/pid" 2>/dev/null)" 2>/dev/null ||
            { [ ! -s "$LOCK/pid" ] && [ $(($(date +%s) - taken)) -lt 60 ]; }; }; then
            echo "Another fleet update or restart runs, as process $(cat "$LOCK/pid" 2>/dev/null); try again once it ends." >&2
            exit 3
        fi
        rm -rf "$LOCK"
        mkdir "$LOCK"
    fi
    echo $$ > "$LOCK/pid"
    locked=1
    trap 'rm -rf "$LOCK"' EXIT
}
locked=''

# In fleet auto, take brain's lock for timed work on each SERVER... that has
# one, as fleet-auto, so it never builds on, restarts or swaps to a server
# someone times: waiting at most 50 minutes each, then the run stops with
# status 4, which fleet auto takes as its hour skipped. unhold releases them.
# A run by hand takes none, as whoever runs it may hold the lock, as a bench
# returning its mini does.
hold() {
    local server
    [ -n "${FLEET_AUTO:-}" ] || return 0
    for server; do
        if [ ! -x "$LOCKS/$server-lock" ] || grep -qx "$server" "$work/held" 2>/dev/null; then continue; fi
        if ! "$LOCKS/$server-lock" take fleet-auto 3000 >/dev/null; then
            echo "$server stays held for timed work ($("$LOCKS/$server-lock" status | head -1)); stopping here." >&2
            exit 4
        fi
        echo "$server" >> "$work/held"
    done
}
unhold() {
    local server
    [ -e "$work/held" ] || return 0
    while read -r server; do
        "$LOCKS/$server-lock" release fleet-auto >/dev/null || echo "$server: could not release its lock." >&2
    done < "$work/held"
}

# Converge, the tunnels moving to the other group first when assign found a
# swap due: its servers held, and the time noted, from which the soak counts.
swap() {
    if [ -n "$swapping" ]; then
        # shellcheck disable=SC2046
        hold $(entries | awk '$2 == "prod" { print $1 }')
        echo "== Swapping: $(entries | awk '$2 == "prod" { print $1 }' | xargs) take prod"
        mkdir -p "$STATE_DIR"
        date +%s > "$SWAPPED"
    fi
    converge
}

# Leave SERVERS as they are, for REASON, and have the run end failing.
incomplete='' unsettled=''
leave() {
    echo "$2; leaving $1 alone." >&2
    incomplete=1
}

# Tell search engines which of the public site's pages this run's prod version
# changed. The first run only notes where it starts, so the site's key is live
# before anything is sent, and a failure waits for the next run: neither
# touches the update.
announce_pages() {
    local new old state="$STATE_DIR/indexnow-prod" script="$HOME/Developer/mono/scripts/indexnow.sh"
    [ -s "$work/pin.prod" ] && [ -x "$script" ] && all_at prod "$(cat "$work/pin.prod")" || return 0
    new="$(cat "$work/pin.prod")"
    old="$(cat "$state" 2>/dev/null || true)"
    [ "$old" != "$new" ] || return 0
    if [ -z "$old" ] || "$script" "$old" "$new"; then
        mkdir -p "$STATE_DIR"
        echo "$new" > "$state"
    fi
}

update() {
    local server tunnel kept='' moving='' pin
    lock
    cf_logged_in
    fetch_tokens
    for tunnel in $(role_tunnels prod) $(role_tunnels next); do
        if [ -z "$(tunnel_id "$tunnel")" ]; then
            echo "fleet.conf gives a role the tunnel $tunnel, which Cloudflare lacks." >&2
            exit 1
        fi
    done
    check_names "$@" || exit 1

    work="$(mktemp -d)"
    trap 'unhold; clear_passwords; rm -rf "$work" "$LOCK"' EXIT
    roles
    # The next group's version: prod's while the prod group does not run it,
    # which the next group then takes prod on; next's newest otherwise, but
    # not within the soak after a swap, while the group that left prod keeps
    # what it ran, from the swap this run makes on.
    if ! all_at prod "$(cat "$work/pin.prod")"; then
        cp "$work/pin.prod" "$work/pin.next"
    elif [ -n "$swapping" ] || [ $(($(date +%s) - $(cat "$SWAPPED" 2>/dev/null || echo 0))) -lt "$soak" ]; then
        echo "== The next group keeps what it runs: prod swapped less than $((soak / 3600)) hours ago."
    elif ! resolve next > "$work/pin.next"; then
        echo "Could not find next's commit." >&2
        exit 1
    fi
    pin="$(cat "$work/pin.next" 2>/dev/null || :)"
    for server in $(order "$@"); do
        if [ "$(role_of "$server")" != next ]; then
            [ "$#" -eq 0 ] || echo "$server serves prod, so it updates once it is next."
        elif [ -z "$pin" ]; then
            :
        # fleet auto leaves alone a server that does not serve, as one stopped
        # on purpose or after a crash, to be looked at.
        elif [ -n "${FLEET_AUTO:-}" ] && ! on "$server" "$SHIP status --check" 2>/dev/null; then
            leave "$server" "$server does not serve, which ship status there explains"
        elif at_pin "$server" "$pin" && held "$server"; then
            echo "$server is held for timed work and has its version: left alone."
        else
            kept="$kept $server"
            at_pin "$server" "$pin" || moving="$moving $server"
        fi
    done
    # shellcheck disable=SC2086
    hold $moving
    swap
    if [ -n "$kept" ]; then
        # shellcheck disable=SC2086
        check_passwords $kept
        # shellcheck disable=SC2086
        fetch $kept
        for server in $kept; do
            if grep -qx "$server" "$work/unready" 2>/dev/null; then
                leave "$server" "$server did not get ready"
            else
                update_server "$server"
            fi
        done
        # A group that now serves prod's pin takes prod.
        probe
        assign
        swap
    fi
    settled
    if [ -n "$incomplete" ]; then
        echo "Not everything was updated; see above." >&2
        exit 1
    fi
    announce_pages
}

restart() {
    local server
    lock
    work="$(mktemp -d)"
    trap 'rm -rf "$work" "$LOCK"' EXIT
    roles
    for server in $(order "$@"); do
        echo "== $server"
        on "$server" 'git -C ~/Developer/dots pull -q --ff-only'
        if ! down "$server"; then
            leave "$server" "$server keeps its tunnels"
            continue
        fi
        detach "$server" "$SHIP stop && $SHIP start"
        follow_job "$server"
        wait_serving "$server"
        converge
    done
    settled
    [ -z "$incomplete" ]
}

# Reboot or shut down (ACTION) SERVER..., all by default, cleanly, one at a
# time, each as a job of its own with its password lent: its workloads stop
# first (server/power.sh). Its tunnels go first (down), and it is left as it
# is when they cannot. Rebooted, the next goes once it is back: serving again,
# its tunnels taken back, if it served, else answering on a new boot, as a
# mini benching.
power() {
    local action="$1" server served booted
    shift
    lock
    work="$(mktemp -d)"
    trap 'clear_passwords; rm -rf "$work" "$LOCK"' EXIT
    roles
    # shellcheck disable=SC2046
    check_passwords $(given "$@")
    for server in $(order "$@"); do
        grep -qx "$server" "$work/checked" 2>/dev/null || continue
        if ! down "$server"; then
            leave "$server" "$server keeps its tunnels"
            continue
        fi
        served=''
        ! up "$server" || served=1
        echo "== $server: $action"
        booted="$(on "$server" 'sysctl -n kern.boottime' || true)"
        if ! lend_password "$server" || ! detach "$server" "$SHIP $action"; then
            echo "$server: could not start its $action." >&2
            incomplete=1
            continue
        fi
        if [ "$action" = shutdown ]; then
            # (It ends with the mini, which then answers no more.)
            follow_job "$server" 60 2>/dev/null || true
            if on "$server" true 2>/dev/null; then
                echo "$server did not shut down; see above." >&2
                incomplete=1
            else
                echo "$server: off."
            fi
            continue
        fi
        # (A failure ends the job at once; the reboot ends it without a
        # status, which the follow reads once the mini answers again.)
        follow_job "$server" 1800 2>/dev/null || true
        if [ "$(on "$server" 'sysctl -n kern.boottime' 2>/dev/null || true)" = "$booted" ]; then
            echo "$server did not reboot; see above." >&2
            incomplete=1
            continue
        fi
        echo "$server: back."
        [ -z "$served" ] || { wait_serving "$server"; converge; }
    done
    settled
    [ -z "$incomplete" ]
}

# The words of the list A that the list B lacks, one a line.
minus() {
    local word
    for word in $1; do
        case " $2 " in
            *" $word "*) ;;
            *) echo "$word" ;;
        esac
    done
}

# Give the servers their roles' tunnels now, updating nothing, as a swap due
# or after an outage (converge): a tunnel moved keeps its floor throughout.
retunnel() {
    lock
    cf_logged_in
    fetch_tokens
    check_names || exit 1
    work="$(mktemp -d)"
    trap 'unhold; rm -rf "$work" "$LOCK"' EXIT
    roles
    swap
    settled
    [ -z "$incomplete" ] || exit 1
    echo "Every server has its tunnels."
}

# How many servers held each tunnel of fleet.conf ready since SINCE, an ISO
# time, a day ago by default, from the servers' tunnels.log, merged: TIME
# TUNNEL COUNT at each change, the changes of one second taken together, then
# the fewest and each span below its floor. A server that does not answer is
# left out, said so.
tunnels_log() {
    local since="${1:-$(date -u -v-1d +%Y-%m-%dT%H:%M:%SZ)}" server tunnel floors=''
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    for server in $(servers); do
        # (Each line as the server it came from, whatever name it wrote.)
        on "$server" 'cat ~/Library/Logs/dots/tunnels.log' 2>/dev/null |
            awk -v server="$server" '{ $2 = server; print }' >"$work/$server" ||
            echo "$server does not answer; its log is left out." >&2 &
    done
    wait
    for tunnel in $(role_tunnels prod) $(role_tunnels next); do
        floors="$floors $tunnel=$(floor "$tunnel")"
    done
    sort "$work"/* | awk -v since="$since" -v floors="$floors" '
        BEGIN { n = split(floors, pairs, " "); for (i = 1; i <= n; i++) { split(pairs[i], kv, "="); floor[kv[1]] = kv[2] } }
        function settle(when) {
            for (t in floor) {
                if ((t in least) && shown[t] == count[t]) continue
                shown[t] = count[t]
                print when, t, count[t] + 0
                if (!(t in least) || count[t] < least[t]) least[t] = count[t] + 0
                if (count[t] < floor[t] && !(t in from)) from[t] = when
                if (count[t] >= floor[t] && (t in from)) { spans[t] = spans[t] "  " from[t] " to " when "\n"; delete from[t] }
            }
        }
        function set(t, server, held) {
            if (!(t in floor) || on[t, server] == held) return
            on[t, server] = held
            count[t] += held ? 1 : -1
        }
        $1 != at { if (at >= since) settle(at); else if ($1 >= since) settle(since); at = $1 }
        $3 == "*" { for (t in floor) set(t, $2, 0); next }
        { set($3, $2, $4 == "connected") }
        END {
            settle(at >= since ? at : since)
            for (t in floor) {
                printf "%s: at least %d since %s, its floor %d\n", t, least[t], since, floor[t]
                if (t in from) spans[t] = spans[t] "  " from[t] " until now\n"
                if (spans[t] != "") printf "  below it:\n%s", spans[t]
            }
        }'
}

status() {
    local work server role tunnels line tunnel versions pin behind waiting
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' RETURN
    roles
    for server in $(given "$@"); do
        { on "$server" "$SHIP status" >"$work/status.$server" 2>/dev/null || echo unreachable >"$work/status.$server"; } &
    done
    wait
    while read -r server role _; do
        line="$(cat "$work/status.$server")"
        printf '%-6s %-4s %s\n' "$server" "$role" "$line"
        [ "$line" != unreachable ] || continue
        tunnels="$(tunnels_of "$server")"
        if [ "$(sed -nE 's/.*, tunnels (.*) [0-9]+\/[0-9]+ ready,.*/\1/p' <<< "$line" | xargs -n 1 | sort | xargs)" != \
            "$(xargs -n 1 <<< "${tunnels:-none}" | sort | xargs)" ]; then
            printf '%-6s its role gives it the tunnels %s; run fleet tunnels\n' '' "${tunnels:-none}"
        fi
        case " $tunnels " in
            *" $server "*) ;;
            *) printf '%-6s has no tunnel of its own; run fleet init %s\n' '' "$server" ;;
        esac
        waiting="$(sed -nE 's/.*, macOS [^ ]+ \(([^ ]+) downloaded\).*/\1/p' <<< "$line")"
        if [ -n "$waiting" ]; then
            printf '%-6s has macOS %s downloaded; fleet update installs it once it is next\n' '' "$waiting"
        fi
    done < <(entries "$@")
    check_names "$@" || true
    for tunnel in $(role_tunnels prod) $(role_tunnels next); do
        versions="$(wanted "$tunnel" | while read -r server; do serving_state "$work/live.$server"; done | sort -u)"
        if [ "$(wc -l <<< "$versions")" -gt 1 ]; then
            echo "$tunnel serves more than one version; run fleet update"
        fi
    done
    # What prod's branch names and the prod group does not run yet, and what
    # next has newer than the next group.
    for role in prod next; do
        if [ "$role" = prod ]; then pin="$(cat "$work/pin.prod")"; else pin="$(resolve next 2>/dev/null)" || continue; fi
        behind="$(entries "$@" | awk -v role="$role" '$2 == role { print $1 }' | while read -r server; do
            answered "$server" && ! at_pin "$server" "$pin" && echo "$server"; done | xargs)"
        [ -z "$behind" ] || echo "$role has ${pin:0:8}, which $behind do not run; run fleet update"
    done
}

# cf, with which fleet init changes Cloudflare and fleet update purges its
# cache, must be logged in.
cf_logged_in() {
    if ! cf auth whoami 2>/dev/null | jq -e .authenticated >/dev/null; then
        echo "cf is not logged in; run fleet init." >&2
        exit 1
    fi
}

# Save in pc/.tunnels each token it lacks of a tunnel fleet.conf names, named
# after a server, or this Mac's own, local, from Cloudflare, which holds them
# all: pc/.tunnels only keeps them at hand, so a new workstation needs no more
# than cf's login.
fetch_tokens() {
    local list='' name id token
    for name in $({ awk '$1 == "group" || $1 == "role" { for (i = 3; i <= NF; i++) print $i }' "$CONF"; echo local; } | sort -u); do
        [ -z "$(tunnel_id "$name")" ] || continue
        # Only when a token is missing, so a run with all of them at hand does
        # without Cloudflare's API.
        [ -n "$list" ] || list="$(cf tunnels list --is-deleted false)"
        id="$(jq -r --arg name "$name" '.[] | select(.name == $name) | .id' <<< "$list" | head -1)"
        [ -n "$id" ] || continue
        echo "$name: saving its token, from Cloudflare, in $TUNNELS"
        token="$(cf tunnels token get "$id" | jq -er .)"
        (umask 077; echo "$name $token" >> "$TUNNELS")
    done
}

# The id of the tunnel whose token pc/.tunnels has as NAME, which the token
# holds. Empty without one.
tunnel_id() {
    awk -v name="$1" '$1 == name { print $2 }' "$TUNNELS" 2>/dev/null |
        base64 -d 2>/dev/null | jq -r '.t // empty' 2>/dev/null || true
}

# With Cloudflare's cf, name every tunnel as pc/.tunnels does, and give each
# SERVER, or each of them, a tunnel named after it that routes SERVER.$DOMAIN
# alone to its site, the only name in DNS that points at it, with its token in
# pc/.tunnels, which fleet update then hands out. It changes only what
# differs, so a rerun changes nothing.
tunnels() {
    local list dns name id cf_name server hostname token ingress config target record current
    cf_logged_in
    fetch_tokens
    list="$(cf tunnels list --is-deleted false)"
    dns="$(cf dns records list --zone "$DOMAIN")"

    for name in $(awk '!/^#/ && NF { print $1 }' "$TUNNELS" 2>/dev/null); do
        id="$(tunnel_id "$name")"
        cf_name="$(jq -r --arg id "$id" '.[] | select(.id == $id) | .name' <<< "$list")"
        if [ -z "$cf_name" ]; then
            echo "$TUNNELS has a token for $name, a tunnel Cloudflare no longer has; remove it." >&2
            exit 1
        fi
        if [ "$cf_name" != "$name" ]; then
            echo "$name: renaming its tunnel from $cf_name"
            cf tunnels edit "$id" --name "$name" >/dev/null
        fi
    done

    for server in $(given "$@"); do
        hostname="$server.$DOMAIN"
        id="$(tunnel_id "$server")"
        if [ -z "$id" ]; then
            id="$(jq -r --arg name "$server" '.[] | select(.name == $name) | .id' <<< "$list" | head -1)"
            if [ -z "$id" ]; then
                echo "$server: creating its tunnel"
                id="$(cf tunnels create --name "$server" --config-source cloudflare | jq -er .id)"
            fi
            echo "$server: saving its token in $TUNNELS"
            token="$(cf tunnels token get "$id" | jq -er .)"
            (umask 077; echo "$server $token" >> "$TUNNELS")
        fi

        ingress="$(jq -nc --arg host "$hostname" --arg site "$SITE" \
            '[{hostname: $host, service: $site}, {service: "http_status:404"}]')"
        config="$(cf tunnels config get "$id" 2>/dev/null | jq -c '.config // {}')" || config=''
        [ -n "$config" ] || config='{}'
        if ! jq -e --argjson ingress "$ingress" \
            '[.ingress[]? | {hostname, service}] == [$ingress[] | {hostname, service}]' <<< "$config" >/dev/null; then
            echo "$server: routing $hostname alone to $SITE"
            cf tunnels config update "$id" \
                --body "$(jq -c --argjson ingress "$ingress" '{config: (.ingress = $ingress)}' <<< "$config")" >/dev/null
        fi

        target="$id.cfargotunnel.com"
        for record in $(jq -r --arg host "$hostname" --arg target "$target" \
            '.[] | select(.content == $target and .name != $host) | "\(.id)=\(.name)"' <<< "$dns"); do
            echo "$server: removing ${record#*=}, which points at its tunnel"
            cf dns records delete "${record%%=*}" --zone "$DOMAIN" --force >/dev/null
        done
        current="$(jq -r --arg host "$hostname" '.[] | select(.name == $host) | "\(.type) \(.content)"' <<< "$dns")"
        case "$current" in
            "CNAME $target") ;;
            '')
                echo "$server: pointing $hostname at its tunnel"
                cf dns records create --zone "$DOMAIN" --body "$(jq -nc --arg host "$hostname" --arg target "$target" \
                    '{type: "CNAME", name: $host, content: $target, proxied: true}')" >/dev/null
                ;;
            *) echo "$hostname already points elsewhere, $current; leaving it." >&2 ;;
        esac
    done
}

# What fleet needs from you, once, for this Mac or after adding a server to
# fleet.conf, each part only where it is missing, so a rerun changes nothing:
# the tailnet's login, Cloudflare's, each SERVER's own tunnel, or all of
# theirs, mini's password on each, and the Rex app's forwards to them.
init() {
    if [ ! -t 0 ]; then
        echo "fleet init may ask you to log in, and for passwords; run it in a terminal." >&2
        exit 1
    fi
    # Tailscale's daemon, set up and logged in, printing the link to open,
    # when it does not run.
    echo "== The tailnet"
    tailscale status --peers=false 2>/dev/null || "$PC_DIR/../shared/tailscale.sh"
    echo "== Cloudflare"
    if ! cf auth whoami 2>/dev/null | jq -e .authenticated >/dev/null; then
        (cd "$HOME/Library/Caches/dots" && command cf auth login)
    fi
    cf_logged_in
    echo "Logged in."
    echo "== Tunnels"
    tunnels "$@"
    echo "Each server has its own tunnel."
    echo "== Passwords"
    init_passwords "$@"
    echo "== Rex"
    "$PC_DIR/trex"
}

# Run fleet update, hourly, from its LaunchAgent: the one check, which brings
# the servers the newest release or commit of their mode, and Homebrew, Rust,
# Rex, cloudflared, and macOS's updates; a run with nothing new restarts
# nothing. It is this Mac's one hourly job, so it keeps this Mac's tunnel on
# the cloudflared installed too, and checks every server serves, whatever it
# skips. Only on power, with this Mac's dots exactly origin's main, which the
# servers pull, and with a server in reach, so a closed or travelling Mac skips its
# hours, and the next one it is open for catches up. It keeps the Mac awake
# meanwhile, logs why it skips an hour, and notifies once when runs start
# failing, or none has run for 2 hours, and again when runs succeed; ship status
# says when none succeeded for over 3 days.

notify() {
    osascript -e "display notification \"See ~/Library/Logs/fleet-auto.log.\" with title \"$1\"" || true
}

# Notify with TITLE, once per KIND until it is cleared: each kind has its own
# marker, as one shared by all hid a skip streak behind a server's answer.
alert() {
    local marker="$STATE_DIR/alerted.$1"
    [ ! -e "$marker" ] || return 0
    mkdir -p "$STATE_DIR"
    touch "$marker"
    notify "$2"
}

# Skip this hour's update for REASON, and notify once no run has succeeded for
# 2 hours, naming the reason it skips now: the last success is the one record
# of a streak, which only a successful update ends, so nothing else is kept.
overdue() {
    echo "$(date '+%Y-%m-%d %H:%M') skipped: $1"
    if [ $(($(date +%s) - $(cat "$STATE_DIR/fleet-auto" 2>/dev/null || echo 0))) -ge 7200 ]; then
        alert skip "fleet update skipped for 2 hours: $1"
    fi
}

# A run succeeded: end the streak the update's alerts began, saying so.
recovered() {
    local kind had=''
    for kind in skip failed long; do
        [ ! -e "$STATE_DIR/alerted.$kind" ] || had=1
        rm -f "$STATE_DIR/alerted.$kind"
    done
    [ -z "$had" ] || notify "fleet update runs again"
}

# Check every server serves, saying and notifying about one that answers but
# does not, and fail when none answers. Its own step, run every hour whatever
# the update skips, so a skipped update never leaves the servers unwatched.
health() {
    local server status answered=''
    for server in $(servers); do
        status=0
        on "$server" "$SHIP status --check" 2>/dev/null || status=$?
        # ssh's own failure: the server does not answer.
        [ "$status" -ne 255 ] || continue
        answered=1
        if [ "$status" -ne 0 ]; then
            echo "$(date '+%Y-%m-%d %H:%M') $server does not serve, which ship status there explains"
            alert "serve.$server" "fleet: $server does not serve"
        else
            rm -f "$STATE_DIR/alerted.serve.$server"
        fi
    done
    [ -n "$answered" ]
}

# Why this Mac's dots, whose fleet runs against the servers, differs from what
# they pull, origin's main, after fetching it; nothing when it does not.
dots_differs() {
    local dots="$1" branch
    git -C "$dots" fetch -q origin main 2>/dev/null || true
    branch="$(git -C "$dots" symbolic-ref -q --short HEAD || echo 'a detached HEAD')"
    if [ -n "$(git -C "$dots" status --porcelain)" ]; then
        echo "dots has uncommitted changes"
    elif [ "$branch" != main ]; then
        echo "dots is on $branch, not main, which the servers pull"
    elif [ "$(git -C "$dots" rev-parse HEAD)" != "$(git -C "$dots" rev-parse origin/main)" ]; then
        echo "dots's main is not origin's, which the servers pull"
    fi
}

auto() {
    local log="$HOME/Library/Logs/fleet-auto.log" dots differs silent='' pid long='' status=0
    dots="$(dirname "$PC_DIR")"
    # Its log keeps the last 5 to 10 MB, cut in place, as launchd writes this
    # run's output to the file it opened.
    if [ "$(stat -f %z "$log" 2>/dev/null || echo 0)" -gt 10485760 ]; then
        tail -c 5242880 "$log" > "$log.new" && cat "$log.new" > "$log"
        rm -f "$log.new"
    fi
    # Every hour, even one it skips: this Mac's tunnel, onto a cloudflared
    # upgraded without ship update.
    "$PC_DIR/tunnel.sh" ||
        echo "$(date '+%Y-%m-%d %H:%M') this Mac's tunnel was not moved onto the cloudflared installed"
    health || silent=1
    if ! pmset -g batt | grep -q "'AC Power'"; then
        echo "$(date '+%Y-%m-%d %H:%M') skipped: on battery"
        return 0
    fi
    differs="$(dots_differs "$dots")"
    if [ -n "$differs" ]; then
        overdue "$differs"
        return 0
    fi
    # Any server in reach, as one down leaves only its group alone.
    if [ -n "$silent" ]; then
        overdue "no server answers"
        return 0
    fi
    echo "== $(date '+%Y-%m-%d %H:%M') fleet update"
    # Watched from here, as launchd starts no other hour's run while this one
    # runs: one that hangs notifies once it has run for a day. Each line it
    # prints is logged with its time, so how long a step took, as a server
    # alone on a tunnel, reads from the log.
    FLEET_AUTO=1 caffeinate -i "$0" update </dev/null \
        > >(while IFS= read -r line; do printf '%s %s\n' "$(date +%T)" "$line"; done) 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [ -z "$long" ] && [ "$SECONDS" -ge 86400 ]; then
            alert long "fleet update has run for a day"
            long=1
        fi
        sleep 60
    done
    wait "$pid" || status=$?
    case "$status" in
        0)
            mkdir -p "$STATE_DIR"
            date +%s > "$STATE_DIR/fleet-auto"
            recovered
            ;;
        # Another run holds the lock, as one by hand: this hour's turn, unless
        # that one hangs, which a day without a run says.
        3) overdue "another fleet update or restart runs" ;;
        # A server it would build on, restart or swap to stayed held for timed
        # work (hold), as during a bench: this hour's turn.
        4) overdue "a server stayed held for timed work for 50 minutes" ;;
        *)
            alert failed "fleet update failed"
            return 1
            ;;
    esac
}

[ "$#" -ge 1 ] || usage
command="$1"
shift
[ "$command" = log ] || for server; do
    servers | grep -qx "$server" || { echo "$server is not in $CONF." >&2; exit 1; }
done
case "$command" in
    init) init "$@" ;;
    status) status "$@" ;;
    restart) restart "$@" ;;
    tunnels)
        [ "$#" -eq 0 ] || usage
        retunnel
        ;;
    log)
        [ "$#" -le 1 ] || usage
        tunnels_log "$@"
        ;;
    reboot | shutdown) power "$command" "$@" ;;
    role)
        [ "$#" -le 1 ] || usage
        work="$(mktemp -d)"
        trap 'rm -rf "$work"' EXIT
        roles
        if [ "$#" -eq 1 ]; then role_of "$1"; else awk '{ print $1, $2 }' "$work/conf"; fi
        ;;
    auto)
        [ "$#" -eq 0 ] || usage
        auto
        ;;
    purge)
        cf_logged_in
        work="$(mktemp -d)"
        trap 'rm -rf "$work"' EXIT
        roles
        # shellcheck disable=SC2046
        purge $(given "$@" | while read -r server; do tunnels_of "$server"; done)
        ;;
    update)
        update "$@"
        ;;
    *) usage ;;
esac
