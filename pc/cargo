#!/bin/sh
# One compiling cargo at a time on this Mac, at low priority. One build already
# takes every core, so two at once finish no sooner and only double load and
# memory (a Mac at load 190 stalls its network). Linked ahead of rustup's
# proxy as /opt/homebrew/bin/cargo, first in every shell's PATH.
#
# The lock covers compiling only. It's a flock on a file descriptor that cargo
# and its children inherit, and cargo starts whatever it runs (cargo run, test,
# bench) through this script as its runner, which drops the lock first: a
# `cargo dev` server holding it for its whole life blocked every other build
# for hours (2026-11-18). The runner also points CARGO at this script, so a
# program that builds again (bindgen --run building bitviewd) queues like any
# other build. A cargo started while the lock is held (a build script or alias
# calling cargo) passes straight through, or it would wait on its own parent.
# Listing and formatting pass straight through too. The lock goes when the
# last process holding the descriptor exits, crash included.
real="$HOME/.cargo/bin/cargo"
self=/opt/homebrew/bin/cargo
export ONE_CARGO_LOCK="${ONE_CARGO_LOCK:-$HOME/Library/Caches/cargo-build.lock}"

if [ "${1:-}" = --one-cargo-runner ]; then
    shift
    exec /usr/bin/perl -e '
        use Fcntl qw(:flock F_SETFD FD_CLOEXEC);
        if (defined(my $fd = delete $ENV{ONE_CARGO_FD})) {
            open(my $f, ">&=", $fd) or die "one-cargo runner: fd $fd: $!\n";
            flock($f, LOCK_UN);
            fcntl($f, F_SETFD, FD_CLOEXEC);
        }
        delete $ENV{ONE_CARGO_HELD};
        $ENV{CARGO} = shift;
        exec { $ARGV[0] } @ARGV or die "one-cargo runner: $ARGV[0]: $!\n";
    ' "$self" "$@"
fi

# The subcommand: the first word that isn't an option, a toolchain or an
# option's value.
sub=
skip=
for arg in "$@"; do
    if [ -n "$skip" ]; then skip=; continue; fi
    case "$arg" in
    --config | --color | -Z | -C) skip=1 ;;
    -* | +*) ;;
    *) sub=$arg; break ;;
    esac
done

case "$sub" in
"" | metadata | tree | fmt | version | help | locate-project | pkgid | search | owner | login | logout | yank | read-manifest | verify-project | clean)
    exec "$real" "$@" ;;
esac
[ -n "${ONE_CARGO_HELD:-}" ] && exec "$real" "$@"

: "${CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER:=$self --one-cargo-runner}"
export CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER
exec /usr/bin/perl -e '
    use Fcntl qw(:flock F_SETFD);
    open(my $f, ">>", $ENV{ONE_CARGO_LOCK}) or die "one-cargo: $ENV{ONE_CARGO_LOCK}: $!\n";
    unless (flock($f, LOCK_EX | LOCK_NB)) {
        print STDERR "waiting for another cargo build\n";
        flock($f, LOCK_EX) or die "one-cargo: lock: $!\n";
    }
    fcntl($f, F_SETFD, 0);
    $ENV{ONE_CARGO_FD} = fileno($f);
    $ENV{ONE_CARGO_HELD} = 1;
    exec { "nice" } "nice", "-n", "10", @ARGV or die "one-cargo: nice: $!\n";
' "$real" "$@"
