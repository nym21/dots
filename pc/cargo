#!/bin/sh
# Queue Cargo builds at low priority. One build already takes every core.
# Two flat-out builds drove load to 106-188. At 190 the network stalls.
# Linked ahead of rustup's proxy as /opt/homebrew/bin/cargo, first in every
# shell's PATH.
#
# The lock covers compiling only. It's a flock on a file descriptor that cargo
# and its children inherit, and cargo starts whatever it runs (cargo run, test,
# bench) through this script as its runner, which drops the lock first: a
# `cargo dev` server holding it for its whole life blocked every other build
# for hours (2026-11-18). The runner also points CARGO at this script, so a
# program that builds again (bindgen --run building bitviewd) queues like any
# other build. A cargo started while the lock is held (a build script or alias
# calling cargo) skips the queue, or it would wait on its own parent, and its
# runner keeps the lock (a nested cargo test let other builds in).
# Listing and formatting pass straight through too. The lock goes when the
# last process holding the descriptor exits, crash included.
# A hold is the exception: its parent keeps the descriptor and waits for the
# script, which runs without it, so a daemon the script leaves running (a
# regtest bitcoind held every build from 18:40 on 2026-11-20) can't keep the
# lock: it frees when the script exits. A plain build still shares the
# descriptor with its children, so a build script that leaves one running would.
real="$HOME/.cargo/bin/cargo"
self=/opt/homebrew/bin/cargo
export ONE_CARGO_LOCK="${ONE_CARGO_LOCK:-$HOME/Library/Caches/cargo-build.lock}"

if [ "${1:-}" = --one-cargo-runner ]; then
    shift
    # A cargo nested in a held build (a one-turn build script) keeps the lock:
    # unlocking the shared descriptor would free it for the whole script.
    if [ -n "${ONE_CARGO_NESTED:-}" ]; then
        export CARGO="$self"
        exec "$@"
    fi
    exec /usr/bin/perl -e '
        use Fcntl qw(:flock F_SETFD FD_CLOEXEC);
        if (defined(my $fd = delete $ENV{ONE_CARGO_FD})) {
            open(my $f, ">&=", $fd) or die "one-cargo runner: fd $fd: $!\n";
            flock($f, LOCK_UN);
            fcntl($f, F_SETFD, FD_CLOEXEC);
        }
        if (defined(my $fd = delete $ENV{ONE_CARGO_LOG_FD})) {
            if (open(my $notify, ">&=", $fd)) {
                local $SIG{PIPE} = "IGNORE";
                syswrite($notify, "\n");
            }
        }
        delete $ENV{ONE_CARGO_HELD};
        $ENV{CARGO} = shift;
        exec { $ARGV[0] } @ARGV or die "one-cargo runner: $ARGV[0]: $!\n";
    ' "$self" "$@"
fi

# `cargo --one-cargo-hold COMMAND...` runs a whole script as one build, queued
# like any other, its cargo calls passing straight through: a script that took
# the lock itself jumped the queue each step, and the oldest waiter starved
# 27 min (2026-11-18).
sub=
skip=
if [ "${1:-}" = --one-cargo-hold ]; then
    shift
    if [ -n "${ONE_CARGO_HELD:-}" ]; then exec "$@"; fi
    real=$1
    shift
    sub=hold
fi
# The subcommand: the first word that isn't an option, a toolchain or an
# option's value.
[ -n "$sub" ] || for arg in "$@"; do
    if [ -n "$skip" ]; then skip=; continue; fi
    case "$arg" in
    --config | --color | --manifest-path | -m | -Z | -C) skip=1 ;;
    -* | +*) ;;
    *) sub=$arg; break ;;
    esac
done

case "$sub" in
"" | metadata | tree | fmt | version | help | locate-project | pkgid | search | owner | login | logout | yank | read-manifest | verify-project | clean)
    exec "$real" "$@" ;;
esac
: "${CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER:=$self --one-cargo-runner}"
export CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER
# Waiters go first come, first served: each leaves a ticket (arrival time and
# pid) in $ONE_CARGO_LOCK.q, and only the oldest live ticket tries the lock. A
# freed flock goes to any blocked waiter, so with every waiter blocked on it a
# build waited 2 h 38 min while newer ones went first (2026-11-18, 20 waiting).
# A ticket whose process is gone (killed, crashed) is skipped and removed.
# A waiter knows its ticket by pid, so renaming one to an earlier time moves it
# up (once the head rechecks, within 2 s); a renamed ticket stranded its
# waiter when they matched by name (2026-11-18).
# A release build can spend ~7 min linking on one core (2026-11-18). load1
# read 91 with only one rustc because of fseventsd. The head tries the slots
# every 2 s. Either slot can start alongside an existing build when rustc
# uses under three cores and memory pressure is normal.
exec /usr/bin/perl -e '
    use Fcntl qw(:flock F_SETFD);
    use POSIX qw(_exit);
    use Time::HiRes qw(time sleep);
    my $sub = shift @ARGV;
    # Cargo config, CARGO_BUILD_TARGET_DIR and target overrides inside aliases are outside this check.
    sub own_target {
        return if $sub =~ /\A(?:hold|fetch|install|update|generate-lockfile|add|remove|rm|init|new|config|info|uninstall|report|install-update|install-update-config)\z/;
        my ($target, $manifest, $directory);
        my @global = ($ARGV[1] // "") =~ /^\+/ ? ($ARGV[1]) : ();
        for (my $i = 1; $i < @ARGV; ++$i) {
            my $arg = $ARGV[$i];
            last if $arg eq "--";
            return if $arg eq "--help" || $arg eq "-h";
            next unless $arg =~ /\A(--target-dir|--manifest-path|-[CmZ])(?:=(.*))?\z/s || $arg =~ /\A(-[CmZ])(.+)\z/s;
            my ($key, $value) = ($1, $2 // $ARGV[++$i]);
            defined $value && length $value or die "one-cargo: missing value for $key\n";
            if ($key eq "--target-dir") { $target = $value }
            elsif ($key eq "--manifest-path" || $key eq "-m") { $manifest = $value }
            else { push @global, $key, $value; $directory = $value if $key eq "-C" }
        }
        push @global, "locate-project", "--workspace", "--message-format", "plain";
        push @global, "--manifest-path", $manifest if defined $manifest;
        open(my $pipe, "-|", $ARGV[0], @global) or die "one-cargo: cannot inspect workspace: $!\n";
        my $project = do { local $/; <$pipe> };
        close($pipe) && defined $project && length $project or die "one-cargo: cannot locate workspace\n";
        chomp $project;
        require Cwd;
        require File::Basename;
        my $root = Cwd::abs_path(File::Basename::dirname($project)) or die "one-cargo: cannot resolve workspace root\n";
        $target //= $ENV{CARGO_TARGET_DIR} // "$root/target";
        length $target or die "one-cargo: empty target path\n";
        $target = "$directory/$target" if defined $directory && $target !~ m{\A/};
        unless (-d $target) { require File::Path; File::Path::make_path($target) }
        $target = Cwd::abs_path($target) or die "one-cargo: cannot resolve $target\n";
        my $marker = "$target/.owner";
        unless (-e $marker) {
            require File::Temp;
            my ($out, $temp) = File::Temp::tempfile(".owner.XXXXXXXX", DIR => $target, UNLINK => 1);
            print {$out} "$root\n" or die "one-cargo: cannot write $temp: $!\n";
            close($out) or die "one-cargo: cannot close $temp: $!\n";
            link($temp, $marker) || $!{EEXIST} or die "one-cargo: cannot claim $target: $!\n";
            unlink($temp) or die "one-cargo: cannot remove $temp: $!\n";
        }
        open(my $record, "<", $marker) or die "one-cargo: cannot read $marker: $!\n";
        my $owner = <$record> // die "one-cargo: empty owner record at $marker\n";
        chomp $owner;
        die "one-cargo: target $target belongs to workspace $owner; workspace $root must use its own CARGO_TARGET_DIR\n"
            if $owner ne $root;
    }
    own_target();
    if (length($ENV{ONE_CARGO_HELD} // "")) {
        $ENV{ONE_CARGO_NESTED} = 1;
        exec { $ARGV[0] } @ARGV or die "one-cargo: $ARGV[0]: $!\n";
    }
    my $queued = time;
    my $q = "$ENV{ONE_CARGO_LOCK}.q";
    sub lockfile { open(my $h, ">>", $_[0]) or die "one-cargo: $_[0]: $!\n"; $h }
    sub reading {
        local $ENV{LC_ALL} = "C";
        my @processes = `ps -Axo %cpu=,comm=`;
        my $cpu = $? == 0 ? 0 : "-";
        if ($cpu ne "-") {
            for (@processes) { $cpu += $1 if m{\A\s*([\d.]+)\s+(?:.*/)?rustc\s*\z} }
        }
        my $level = `sysctl -n kern.memorystatus_vm_pressure_level`;
        my $pressure = $? == 0 && $level =~ /\A(\d+)\s*\z/ ? $1 : "-";
        ($cpu eq "-" ? $cpu : sprintf("%.1f", $cpu), $pressure);
    }
    # The live tickets, oldest first; dead ones are removed.
    sub line {
        opendir(my $d, $q) or return ();
        my @live;
        for (sort grep { /^\d+-\d+$/ } readdir $d) {
            my ($pid) = /-(\d+)$/;
            if (kill 0, $pid) { push @live, $_ } else { unlink "$q/$_" }
        }
        @live;
    }
    my @slots = map { lockfile($_) } $ENV{ONE_CARGO_LOCK}, "$ENV{ONE_CARGO_LOCK}.2";
    sub take {
        for my $i (0, 1) {
            my ($mine, $other) = @slots[$i, 1 - $i];
            next unless flock($mine, LOCK_EX | LOCK_NB);
            if (flock($other, LOCK_EX | LOCK_NB)) { flock($other, LOCK_UN); return ($i + 1, "-", "-") }
            my ($cpu, $pressure) = reading();
            return ($i + 1, $cpu, $pressure) if $cpu ne "-" && $cpu < 300 && $pressure eq "1";
            flock($mine, LOCK_UN);
            last;
        }
        ();
    }
    mkdir $q;
    my $mine = sprintf("%017.0f-%d", time * 1e6, $$);
    my ($slot, $rustc_cpu, $pressure, $waiting);
    while (1) {
        # Match by pid so a rename keeps its place and a removed ticket comes back.
        my @line = line();
        unless (grep { /-$$\z/ } @line) {
            open(my $ticket, ">", "$q/$mine") or die "one-cargo: $q/$mine: $!\n";
            close $ticket;
            @line = line();
        }
        if ($line[0] =~ /-$$\z/) {
            $mine = $line[0];
            ($slot, $rustc_cpu, $pressure) = take();
            last if $slot;
        }
        print STDERR "waiting for another cargo build\n" unless $waiting++;
        sleep 2;
    }
    unlink "$q/$mine";
    print STDERR "cargo slot $slot\n" if $waiting;
    my $f = $slots[$slot - 1];
    $ENV{ONE_CARGO_SLOT} = $slot;
    $ENV{ONE_CARGO_HELD} = 1;
    # A hold script never gets the descriptor (it stays close-on-exec); see the header.
    unless ($sub eq "hold") {
        fcntl($f, F_SETFD, 0);
        $ENV{ONE_CARGO_FD} = fileno($f);
    }
    sub log_build {
        my $start = time;
        my @head = ($sub =~ /\A[a-z][a-z0-9_-]{0,31}\z/ ? $sub : "cargo");
        # Omit arbitrary values such as registry credentials and runner args.
        for (my $i = 1; $sub ne "hold" && $i < @ARGV && @head < 6; ++$i) {
            my $arg = $ARGV[$i];
            last if $arg eq "--";
            if ($arg =~ /\A(--release|--locked|--workspace)\z/) { push @head, $arg }
            if ($arg =~ /\A(-p|--package|--bin|--profile)\z/ && ($ARGV[$i+1] // "") =~ /\A[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,63}\z/) {
                push @head, $arg, $ARGV[++$i];
            }
        }
        open(my $log, ">>", "$ENV{HOME}/Library/Logs/cargo-shim.log") or return;
        pipe(my $read, my $write) or return;
        fcntl($write, F_SETFD, 0) or return;
        my $pid = fork();
        return unless defined $pid;
        if ($pid) { $ENV{ONE_CARGO_LOG_FD} = fileno($write); return $write }
        # Keep the Cargo PID and finish the record when it exits or its runner unlocks.
        $SIG{$_} = "IGNORE" for qw(HUP INT TERM);
        close $f;
        close $write;
        close STDIN;
        close STDOUT;
        close STDERR;
        sysread($read, my $done, 1);
        my $line = sprintf("start=%.3f end=%.3f slot=%d wait=%.3f rustc_cpu=%s pressure=%s args=\"%s\"\n",
            $start, time, $ENV{ONE_CARGO_SLOT}, $start - $queued, $rustc_cpu, $pressure, join(" ", @head));
        syswrite($log, $line);
        _exit(0);
    }
    my $notify = log_build() or warn "one-cargo: cannot log build: $!\n";
    if ($sub eq "hold") {
        my $pid;
        $SIG{$_} = sub { kill $_[0], $pid if $pid } for qw(HUP INT TERM);
        $pid = fork // die "one-cargo: fork: $!\n";
        unless ($pid) {
            $SIG{$_} = "DEFAULT" for qw(HUP INT TERM);
            close $notify if $notify;
            delete $ENV{ONE_CARGO_LOG_FD};
            exec { "nice" } "nice", "-n", "10", @ARGV or die "one-cargo: nice: $!\n";
        }
        while (waitpid($pid, 0) != $pid) { $!{EINTR} or die "one-cargo: waiting for $ARGV[0]: $!\n" }
        exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
    }
    exec { "nice" } "nice", "-n", "10", @ARGV or die "one-cargo: nice: $!\n";
' "$sub" "$real" "$@"
