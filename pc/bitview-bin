#!/bin/sh
# State                  Event                 Result
# Cached                 Request arrives       Return the cache path without a ticket.
# Missing                Request arrives       Build, stage, and rename the binary into place.
# Building elsewhere     Same request arrives  Wait for publication and recheck the cache.
# Killed mid-build       Retry                 Restore the source tree and build again.
# Killed mid-copy        Retry                 Discard the staged copy and build again.
# Disk full              A write fails         Report the failed step before publication.
# SHA not in mono        Request arrives       Report the unknown commit before queueing.

fail() { printf 'bitview-bin: %s\n' "$*" >&2; exit 1; }
usage() { fail 'usage: bitview-bin <sha> [--bin name]'; }

mode=
case "${1:-}" in --queue|--build|--compile) mode=$1; shift ;; esac
[ "$#" -ge 1 ] || usage
ref=$1
shift
case "$ref" in ''|*[!0-9a-fA-F]*) usage ;; esac
bin=bitviewd
if [ "$#" -ne 0 ]; then
    [ "$#" -eq 2 ] && [ "$1" = --bin ] || usage
    bin=$2
fi
case "$bin" in ''|[-.]*|*[!a-zA-Z0-9_.-]*) usage ;; esac

mono=$HOME/Developer/mono
sha=$(git -C "$mono" rev-parse --verify --quiet "$ref^{commit}") ||
    fail "commit $ref is not in mono"
root=$HOME/Library/Caches/bitview-bins
dest=$root/$sha-regtest
file=$dest/$bin
if [ -f "$file" ] && [ -x "$file" ] && [ -f "$file.sha256" ]; then
    printf '%s/\n' "$dest"
    exit
fi

locks=$root/.locks
mkdir -p "$locks" || fail "cannot create cache for $sha"
# Coalesce top-level requests for this SHA before queueing. A nested request
# can already own the Cargo slot the queued request is waiting for.
if [ -z "$mode" ] && [ -z "${ONE_CARGO_HELD:-}" ]; then
    exec lockf -k "$locks/$sha.request" "$0" --queue "$sha" --bin "$bin"
fi
case "$mode" in
    ''|--queue) exec cargo --one-cargo-hold lockf -k "$locks/$sha.build" "$0" --build "$sha" --bin "$bin" ;;
esac
[ -n "${ONE_CARGO_HELD:-}" ] || fail 'build must run inside cargo --one-cargo-hold'
case "${ONE_CARGO_SLOT:-}" in 1|2) ;; *) fail 'cargo hold must assign slot 1 or 2' ;; esac

tree=$HOME/Library/Caches/bitview-build/slot$ONE_CARGO_SLOT
mkdir -p "${tree%/*}" || fail "cannot create build directory for $sha"
# Nested commands can share a hold. Serialize writers to this slot's tree.
if [ "$mode" = --build ]; then
    exec lockf -k "$tree.lock" "$0" --compile "$sha" --bin "$bin"
fi
src=$tree
target=$tree-target
index=$tree.index
stage=$root/.stage-$ONE_CARGO_SLOT
[ ! -L "$src" ] && [ ! -e "$src/.git" ] || fail "source cache is a checkout or symlink at $src"
[ ! -L "$target" ] || fail "target directory is a symlink at $target"
mkdir -p "$src" || fail "cannot create source tree for $sha"
rm -f "$index.lock" "$stage" "$stage.sha256" || fail "cannot clear staging for $sha"
trap 'rm -f "$stage" "$stage.sha256"' 0
trap 'exit 1' HUP INT TERM
source_git() { GIT_INDEX_FILE="$index" git -C "$mono" --work-tree="$src" "$@"; }
source_git read-tree --reset -u "$sha" && source_git clean -fdx >&2 ||
    fail "cannot sync mono source for $sha"

cd "$src" || fail "cannot enter source tree for $sha"
CARGO_TARGET_DIR="$target" cargo build --locked --profile regtest --bin "$bin" >&2 ||
    fail "cargo build failed for $sha ($bin)"
artifact=$target/regtest/$bin
[ -f "$artifact" ] && [ -x "$artifact" ] && cp -p "$artifact" "$stage" ||
    fail "cannot stage $bin for $sha"
digest=$(shasum -a 256 "$stage") && printf '%s  %s\n' "${digest%% *}" "$bin" >"$stage.sha256" ||
    fail "cannot record checksum of $bin for $sha"

# Both slots publish under one short lock. The binary's last rename makes
# the checksum and binary visible as a complete entry.
lockf -k "$locks/publish" sh -s "$root" "$dest" "$file" "$stage" <<'PUBLISH' || fail "cannot publish $bin for $sha"
root=$1 dest=$2 file=$3 stage=$4
[ ! -d "$file" ] && [ ! -d "$file.sha256" ] && mkdir -p "$dest" && rm -f "$file" &&
    mv -f "$stage.sha256" "$file.sha256" && mv -f "$stage" "$file" || exit 1
prune() {
    cd "$root" || return 1
    entries=$(ls -1dt -- *-regtest/) || return 1
    kept=0
    while IFS= read -r entry; do
        case "${entry%-regtest/}" in ''|*[!0-9a-f]*) continue ;; esac
        kept=$((kept + 1))
        [ "$kept" -le 5 ] || rm -rf -- "$entry" || return 1
    done <<EOF
$entries
EOF
}
prune || printf 'bitview-bin: cannot prune %s\n' "$root" >&2
PUBLISH
printf '%s/\n' "$dest"
